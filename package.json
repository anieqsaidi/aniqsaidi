{
  "name": "astro-terminal",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "snapshot:cms:v2": "node scripts/migrate-cms-v2.mjs",
    "test:cms": "node --test tests/cms-schema.test.mjs",
    "test:editorial": "node --test tests/cms-editorial.test.mjs",
    "test:operations": "node --test tests/cms-operations.test.mjs",
    "test:accessibility": "node --test tests/accessibility.test.mjs",
    "test:public-cms": "node --test tests/public-cms-rendering.test.mjs",
    "test:email": "node --test tests/cv-email-template.test.mjs",
    "test:ordering": "node --test tests/record-order.test.mjs tests/content-sort.test.mjs",
    "test:security": "node --test tests/cv-security.test.mjs tests/security-posture.test.mjs",
    "verify:prod": "npm run build && npm run test:cms && npm run test:editorial && npm run test:operations && npm run test:accessibility && npm run test:public-cms && npm run test:email && npm run test:ordering && npm run test:security",
    "deploy:prod": "npm run verify:prod && firebase deploy --only functions,hosting,firestore:rules,storage --project aniqsaidi",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aniqsaidi \"node --test tests/firestore.rules.test.mjs\"",
    "test:storage": "firebase emulators:exec --only storage --project demo-aniqsaidi \"node --test tests/storage.rules.test.mjs\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.1.3",
    "firebase": "^12.17.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1"
  }
}
