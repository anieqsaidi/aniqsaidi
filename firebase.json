{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/admin/insights",
        "function": {
          "functionId": "adminInsights",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/request-cv",
        "function": {
          "functionId": "requestCv",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/cv/verify",
        "function": {
          "functionId": "verifyCv",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/cv/download",
        "function": {
          "functionId": "downloadCv",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/batam/login",
        "function": {
          "functionId": "batamLogin",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/batam/profile",
        "function": {
          "functionId": "batamProfile",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/batam/document",
        "function": {
          "functionId": "batamDocument",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/batam/admin",
        "function": {
          "functionId": "batamAdmin",
          "region": "asia-southeast1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/{about,projects,experience,certifications,awards,leadership,archives,resume}{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/admin",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "Cache-Control",
            "value": "private, no-store"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "Cache-Control",
            "value": "private, no-store"
          }
        ]
      },
      {
        "source": "/batam{,/**}",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "Cache-Control",
            "value": "private, no-cache"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  }
}
