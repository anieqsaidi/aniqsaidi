---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import AnimatedText from '../components/AnimatedText.astro';
import RecordHighlights from '../components/RecordHighlights.astro';
import ContentSort from '../components/ContentSort.astro';
import { awards } from '../data/cv';
import { latestFirst } from '../data/recordOrder';

const sortedAwards = latestFirst(awards.map(([title, detail], index) => ({
  title, detail, description: detail, index, sortOrder: index,
})));

const highlightedIndexes = new Set([0, 1, 5]);
const highlightRecords = awards.map(([title, detail], index) => ({
  index,
  signal: index === 5 ? 'BUILD // SILVER' : index === 0 ? 'IMPACT // EXCELLENCE' : 'DELIVERY // PERFORMANCE',
  title,
  description: detail,
  featured: highlightedIndexes.has(index),
}));
---

<Layout title="AWARDS" description="Awards, recognition, and leadership achievements of Aniq Saidi.">
  <Frame title="AWARDS & RECOGNITION">
    <RecordHighlights page="awards" records={highlightRecords} />
    <ContentSort scope="awards" />
    <div class="credential-list" data-cms-collection="awards.awards" data-sort-scope="awards" data-sort-container>
      {sortedAwards.map(({ title, detail, index }) => (
        <article class="credential credential--stacked" data-sort-item data-sort-date={detail} data-sort-title={title}>
          <div>
            <h2 data-cms-field={`awards.${index}.title`}>
                {index === 0
                  ? <AnimatedText text={title} word="Excellence" effect="wave" delay={-1.8} />
                  : index === 1
                    ? <AnimatedText text={title} word="Performer" effect="pulse" delay={-3.3} />
                    : index === 5
                      ? <AnimatedText text={title} word="Silver" effect="pulse" delay={-4.9} />
                      : index === 6
                        ? <AnimatedText text={title} word="Special" effect="invert" delay={-2.1} />
                        : index === 7
                          ? <AnimatedText text={title} word="Dean's" effect="flicker" delay={-5.8} />
                          : title}
            </h2>
            <p data-cms-field={`awards.${index}.detail`}>{detail}</p>
          </div>
        </article>
      ))}
    </div>
  </Frame>

</Layout>
