---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import AnimatedText from '../components/AnimatedText.astro';
import { experience, skillGroups } from '../data/cv';

const recentExperience = experience.slice(0, 1);
const earlierExperience = experience.slice(1);
const earlierRoleEffects = [
  { word: 'Senior', effect: 'pulse', delay: -4.8, alt: undefined },
  { word: 'Systems', effect: 'flicker', delay: -2.4, alt: undefined },
  { word: 'Developer', effect: 'decode', delay: -5.6, alt: 'D3V3L0P3R' },
] as const;
const earlierHighlightEffects = [
  { word: 'optimized', effect: 'wave', delay: -2.9 },
  { word: 'Conducted', effect: 'scan', delay: -4.4 },
  { word: 'Developed', effect: 'jitter', delay: -3.5 },
] as const;
const toolkitEffects = [
  { word: 'JavaScript', effect: 'scan', delay: -1.3 },
  { word: 'Python', effect: 'decode', delay: -3.8, alt: 'PY7H0N' },
  { word: 'Tableau', effect: 'pulse', delay: -5.2 },
  { word: 'Linux', effect: 'flicker', delay: -2.6 },
  { word: 'AI Integration', effect: 'wave', delay: -4.5 },
] as const;
---

<Layout title="EXPERIENCE" description="Professional experience and technical toolkit of Aniq Saidi.">
  <Frame title="WORK EXPERIENCE">
    <div class="timeline">
      {recentExperience.map((job) => (
        <article class="timeline-item">
          <header class="timeline-head">
            <div>
              <h2>{job.role}</h2>
              <p>{job.company}</p>
            </div>
            <time datetime={job.start}>{job.period}</time>
          </header>
          <p class="timeline-location">{job.location}</p>
          <ul>
            {job.highlights.map((highlight, index) => (
              <li>
                {index === 0
                  ? <AnimatedText text={highlight} word="patient-management" effect="scan" delay={-1.2} />
                  : index === 1
                    ? <AnimatedText text={highlight} word="workforce-management" effect="wave" delay={-3.7} />
                    : highlight}
              </li>
            ))}
          </ul>
          <p class="skill-line"><span>STACK:</span> {job.skills.join(' // ')}</p>
        </article>
      ))}
    </div>

    <details class="career-details">
      <summary>
        <span class="details-closed">[+] READ MORE EXPERIENCE</span>
        <span class="details-open">[-] SHOW LESS EXPERIENCE</span>
      </summary>
      <div class="timeline timeline--continued">
        {earlierExperience.map((job, jobIndex) => (
          <article class="timeline-item">
            <header class="timeline-head">
              <div>
                <h2>
                  <AnimatedText
                    text={job.role}
                    word={earlierRoleEffects[jobIndex].word}
                    effect={earlierRoleEffects[jobIndex].effect}
                    delay={earlierRoleEffects[jobIndex].delay}
                    alt={earlierRoleEffects[jobIndex].alt}
                  />
                </h2>
                <p>{job.company}</p>
              </div>
              <time datetime={job.start}>{job.period}</time>
            </header>
            <p class="timeline-location">{job.location}</p>
            <ul>
              {job.highlights.map((highlight, highlightIndex) => (
                <li>
                  {highlightIndex === 0
                    ? <AnimatedText
                        text={highlight}
                        word={earlierHighlightEffects[jobIndex].word}
                        effect={earlierHighlightEffects[jobIndex].effect}
                        delay={earlierHighlightEffects[jobIndex].delay}
                      />
                    : highlight}
                </li>
              ))}
            </ul>
            <p class="skill-line"><span>STACK:</span> {job.skills.join(' // ')}</p>
          </article>
        ))}
      </div>
    </details>
  </Frame>

  <details class="mobile-more" open>
    <summary>
      <span class="details-closed">[+] SHOW TOOLKIT</span>
      <span class="details-open">[-] HIDE TOOLKIT</span>
    </summary>
    <Frame title="TOOLKIT">
      <dl class="records skill-records">
        {skillGroups.map(([group, skills], index) => (
          <>
            <dt>{group}</dt>
            <dd>
              <AnimatedText
                text={skills}
                word={toolkitEffects[index].word}
                effect={toolkitEffects[index].effect}
                delay={toolkitEffects[index].delay}
                alt={'alt' in toolkitEffects[index] ? toolkitEffects[index].alt : undefined}
              />
            </dd>
          </>
        ))}
      </dl>
    </Frame>
  </details>

</Layout>
