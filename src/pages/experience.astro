---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import AnimatedText from '../components/AnimatedText.astro';
import { experience, skillGroups } from '../data/cv';

const earlierRoleEffects = [
  { word: 'Senior', effect: 'pulse', delay: -4.8, alt: undefined },
  { word: 'Systems', effect: 'flicker', delay: -2.4, alt: undefined },
  { word: 'Developer', effect: 'decode', delay: -5.6, alt: 'D3V3L0P3R' },
] as const;
const earlierHighlightEffects = [
  { word: 'optimized', effect: 'wave', delay: -2.9 },
  { word: 'Conducted', effect: 'scan', delay: -4.4 },
  { word: 'Developed', effect: 'jitter', delay: -3.5 },
] as const;
const toolkitEffects = [
  { word: 'JavaScript', effect: 'scan', delay: -1.3 },
  { word: 'Python', effect: 'decode', delay: -3.8, alt: 'PY7H0N' },
  { word: 'Tableau', effect: 'pulse', delay: -5.2 },
  { word: 'Linux', effect: 'flicker', delay: -2.6 },
  { word: 'AI Integration', effect: 'wave', delay: -4.5 },
] as const;
---

<Layout title="EXPERIENCE" description="Professional experience and technical toolkit of Aniq Saidi.">
  <Frame title="WORK EXPERIENCE">
    <div class="timeline" data-cms-collection="experience.jobs">
      {experience.map((job, jobIndex) => (
        <article class="timeline-item">
          <header class="timeline-head">
            <div>
              <h2 data-cms-field={`experience.jobs.${jobIndex}.role`}>
                {jobIndex === 0
                  ? job.role
                  : <AnimatedText
                      text={job.role}
                      word={earlierRoleEffects[jobIndex - 1].word}
                      effect={earlierRoleEffects[jobIndex - 1].effect}
                      delay={earlierRoleEffects[jobIndex - 1].delay}
                      alt={earlierRoleEffects[jobIndex - 1].alt}
                    />}
              </h2>
              <p data-cms-field={`experience.jobs.${jobIndex}.company`}>{job.company}</p>
            </div>
            <time datetime={job.start} data-cms-field={`experience.jobs.${jobIndex}.period`}>{job.period}</time>
          </header>
          <p class="timeline-location" data-cms-field={`experience.jobs.${jobIndex}.location`}>{job.location}</p>
          <ul>
            {job.highlights.map((highlight, highlightIndex) => (
              <li data-cms-field={`experience.jobs.${jobIndex}.highlights.${highlightIndex}`}>
                {jobIndex === 0 && highlightIndex === 0
                  ? <AnimatedText text={highlight} word="patient-management" effect="scan" delay={-1.2} />
                  : jobIndex === 0 && highlightIndex === 1
                    ? <AnimatedText text={highlight} word="workforce-management" effect="wave" delay={-3.7} />
                    : jobIndex > 0 && highlightIndex === 0
                      ? <AnimatedText
                          text={highlight}
                          word={earlierHighlightEffects[jobIndex - 1].word}
                          effect={earlierHighlightEffects[jobIndex - 1].effect}
                          delay={earlierHighlightEffects[jobIndex - 1].delay}
                        />
                      : highlight}
              </li>
            ))}
          </ul>
          <p class="skill-line"><span>STACK:</span> <span data-cms-field={`experience.jobs.${jobIndex}.skills`}>{job.skills.join(' // ')}</span></p>
        </article>
      ))}
    </div>

  </Frame>

  <Frame title="TOOLKIT">
    <dl class="records skill-records" data-cms-collection="experience.toolkit">
      {skillGroups.map(([group, skills], index) => (
        <>
          <dt data-cms-field={`experience.toolkit.${index}.group`}>{group}</dt>
          <dd data-cms-field={`experience.toolkit.${index}.skills`}>
            <AnimatedText
              text={skills}
              word={toolkitEffects[index].word}
              effect={toolkitEffects[index].effect}
              delay={toolkitEffects[index].delay}
              alt={'alt' in toolkitEffects[index] ? toolkitEffects[index].alt : undefined}
            />
          </dd>
        </>
      ))}
    </dl>
  </Frame>

</Layout>
