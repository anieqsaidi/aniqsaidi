---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import AnimatedText from '../components/AnimatedText.astro';
import RecordHighlights from '../components/RecordHighlights.astro';
import ContentSort from '../components/ContentSort.astro';
import { certifications } from '../data/cv';

const sortedCertifications = [...certifications].sort((a, b) =>
  b.datetime.localeCompare(a.datetime),
);
const certificationEffects = [
  { match: 'Power BI', word: 'Power BI', effect: 'pulse', delay: -1.1 },
  { match: 'Azure', word: 'Azure', effect: 'decode', delay: -2.4, alt: 'AZUR3' },
  { match: 'Tableau', word: 'Tableau', effect: 'scan', delay: -3.7 },
  { match: 'Cloud', word: 'Cloud', effect: 'flicker', delay: -4.9 },
  { match: 'Security', word: 'Security', effect: 'jitter', delay: -2.9 },
  { match: 'Storage', word: 'Storage', effect: 'wave', delay: -5.5 },
  { match: 'Qlik', word: 'Qlik', effect: 'invert', delay: -1.8 },
  { match: 'Python', word: 'Python', effect: 'decode', delay: -4.2, alt: 'PY7H0N' },
  { match: 'Scrum', word: 'Scrum', effect: 'pulse', delay: -3.2 },
] as const;

const effectForCertification = (title: string) =>
  certificationEffects.find(({ match }) => title.includes(match));

const highlightedTitles = new Set([
  'Professional Scrum Master I',
  'Tableau 2024.1: Essential Training',
  'AWS Partner: Security Best Practices (Technical)',
]);

const highlightRecords = certifications.map((certification, index) => ({
  index,
  signal: certification.title.includes('Scrum')
    ? 'DELIVERY // AGILE'
    : certification.title.includes('Tableau')
      ? 'DATA // VISUALISATION'
      : 'CLOUD // SECURITY',
  title: certification.title,
  description: certification.issuer,
  meta: certification.date,
  featured: highlightedTitles.has(certification.title),
}));
---

<Layout title="CERTIFICATIONS" description="Professional certifications earned by Aniq Saidi.">
  <Frame title="CERTIFICATIONS">
    <RecordHighlights page="certifications" records={highlightRecords} />
    <ContentSort scope="certifications" />
    <div class="credential-list" data-cms-collection="certifications.certifications" data-sort-scope="certifications" data-sort-container>
      {sortedCertifications.map((certification) => (
        <article class="credential certification" data-sort-item data-sort-date={certification.datetime} data-sort-title={certification.title}>
          <div>
            <h2 data-cms-field={`certifications.${certifications.indexOf(certification)}.title`}>
              {effectForCertification(certification.title) ? (
                <AnimatedText
                  text={certification.title}
                  word={effectForCertification(certification.title)!.word}
                  effect={effectForCertification(certification.title)!.effect}
                  delay={effectForCertification(certification.title)!.delay}
                  alt={'alt' in effectForCertification(certification.title)!
                    ? effectForCertification(certification.title)!.alt
                    : undefined}
                />
              ) : certification.title}
            </h2>
            <p data-cms-field={`certifications.${certifications.indexOf(certification)}.issuer`}>{certification.issuer}</p>
          </div>
          <time datetime={certification.datetime} data-cms-field={`certifications.${certifications.indexOf(certification)}.date`}>{certification.date}</time>
        </article>
      ))}
    </div>
  </Frame>
</Layout>
