---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';

const requestEndpoint = '/api/request-cv';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
---

<Layout title="REQUEST CV" description="Request Aniq Saidi's current professional CV by email.">
  <Frame title="REQUEST CV">
    <section
      class="cv-request"
      id="cv-request"
      data-request-endpoint={requestEndpoint}
      data-turnstile-configured={String(Boolean(turnstileSiteKey))}
      aria-labelledby="cv-request-title"
    >
      <div class="cv-request__intro">
        <p class="prompt">&gt; PRIVATE DOCUMENT // VERIFIED ACCESS</p>
        <h1 id="cv-request-title">REQUEST CURRENT CV</h1>
        <p>
          Enter your email address and confirm it from your inbox. Once verified,
          you will receive temporary access to the latest CV.
        </p>
      </div>

      <form class="cv-request__form" id="cv-request-form" novalidate>
        <label for="cv-request-email">EMAIL ADDRESS</label>
        <div class="cv-request__input-row">
          <span aria-hidden="true">&gt;</span>
          <input
            id="cv-request-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            maxlength="254"
            placeholder="you@example.com"
            aria-describedby="cv-request-privacy cv-request-status"
            required
          />
        </div>

        <div class="cv-request__trap" aria-hidden="true">
          <label for="cv-request-company">COMPANY WEBSITE</label>
          <input id="cv-request-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label class="cv-request__consent" for="cv-request-consent">
          <input id="cv-request-consent" name="consent" type="checkbox" required />
          <span>I agree to use the CV for legitimate professional or recruitment purposes.</span>
        </label>

        {turnstileSiteKey && (
          <div class="cv-request__turnstile cf-turnstile" data-sitekey={turnstileSiteKey} data-action="request_cv" data-theme="auto"></div>
        )}

        <p class="cv-request__privacy" id="cv-request-privacy">
          The verification link expires in 30 minutes. CV access expires after 24 hours or three downloads.
        </p>

        <button class="cv-request__submit" type="submit" disabled={!turnstileSiteKey}>REQUEST CV <span aria-hidden="true">↗</span></button>
        <p class="cv-request__status" id="cv-request-status" role="status" aria-live="polite"></p>
      </form>

      <a class="cv-request__return" href="/about/">&lt; RETURN TO PROFILE</a>
    </section>
  </Frame>
</Layout>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const root = document.querySelector<HTMLElement>('#cv-request');
  const form = document.querySelector<HTMLFormElement>('#cv-request-form');
  const email = document.querySelector<HTMLInputElement>('#cv-request-email');
  const consent = document.querySelector<HTMLInputElement>('#cv-request-consent');
  const trap = document.querySelector<HTMLInputElement>('#cv-request-company');
  const status = document.querySelector<HTMLElement>('#cv-request-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (root?.dataset.turnstileConfigured !== 'true') {
    setTimeout(() => setStatus('CV REQUESTS REQUIRE TURNSTILE CONFIGURATION.', 'error'));
  }

  const setStatus = (message: string, state: 'error' | 'success' | 'idle' = 'idle') => {
    if (!status) return;
    status.textContent = message;
    status.dataset.state = state;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setStatus('');

    if (!email?.validity.valid) {
      email?.focus();
      setStatus('ENTER A VALID EMAIL ADDRESS.', 'error');
      return;
    }
    if (!consent?.checked) {
      consent?.focus();
      setStatus('CONFIRM THE PROFESSIONAL-USE NOTICE TO CONTINUE.', 'error');
      return;
    }
    if (trap?.value) return;
    const turnstileToken = new FormData(form).get('cf-turnstile-response')?.toString() ?? '';
    if (!turnstileToken) {
      setStatus('COMPLETE THE SECURITY CHECK TO CONTINUE.', 'error');
      return;
    }

    const endpoint = root?.dataset.requestEndpoint?.trim();
    if (!endpoint) {
      setStatus('REQUEST EMAIL IS NOT ACTIVE YET. NO ADDRESS WAS SAVED AND NO CV WAS SENT.', 'error');
      return;
    }

    if (submit) submit.disabled = true;
    setStatus('VERIFYING REQUEST...');

    let succeeded = false;
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: email.value.trim(),
          company: trap?.value ?? '',
          consent: consent.checked,
          turnstileToken,
          source: 'aniqsaidi.my/resume',
        }),
      });
      if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
      succeeded = true;
      setStatus('REQUEST ACCEPTED. OPENING INBOX INSTRUCTIONS...', 'success');
      window.location.assign('/resume/requested/');
    } catch (error) {
      console.warn('CV request could not be delivered.', error);
      setStatus('REQUEST COULD NOT BE SENT. PLEASE TRY AGAIN LATER.', 'error');
    } finally {
      if (!succeeded) {
        if (submit) submit.disabled = false;
        (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
      }
    }
  });
</script>

<style>
  .cv-request {
    display: grid;
    width: min(100%, 720px);
    min-height: 360px;
    margin: 0 auto;
    gap: clamp(20px, 4vw, 32px);
    align-content: center;
  }

  .cv-request__intro { display: grid; gap: 10px; }
  .cv-request__intro > * { margin: 0; }
  .cv-request__intro .prompt { color: var(--fg-bright); font-size: .78rem; letter-spacing: .08em; }
  .cv-request__intro h1 { color: var(--fg-bright); font-size: clamp(1.15rem, 4vw, 1.65rem); }
  .cv-request__intro > p:last-child { max-width: 62ch; color: var(--fg-dim); line-height: 1.6; }

  .cv-request__form { display: grid; gap: 13px; }
  .cv-request__form > label:first-child { color: var(--fg-bright); font-size: .78rem; letter-spacing: .1em; }

  .cv-request__input-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 11px 14px;
    border: 1px solid var(--fg-dim);
    background: color-mix(in srgb, var(--fg) 4%, transparent);
  }

  .cv-request__input-row:focus-within { border-color: var(--fg-bright); box-shadow: 0 0 16px color-mix(in srgb, var(--fg) 18%, transparent); }
  .cv-request__input-row span { color: var(--fg-bright); }
  .cv-request__input-row input {
    min-width: 0;
    border: 0;
    outline: 0;
    color: var(--fg-bright);
    background: transparent;
    font: inherit;
  }
  .cv-request__input-row input::placeholder { color: var(--fg-dim); opacity: .72; }

  .cv-request__consent {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    color: var(--fg-dim);
    font-size: .78rem;
    line-height: 1.5;
    cursor: pointer;
  }
  .cv-request__consent input { margin: 3px 0 0; accent-color: var(--fg-bright); }

  .cv-request__privacy { margin: 0; color: var(--fg-dim); font-size: .7rem; line-height: 1.5; }
  .cv-request__turnstile { min-height: 65px; }
  .cv-request__trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .cv-request__submit {
    justify-self: start;
    padding: 10px 14px;
    border: 1px solid var(--fg-bright);
    color: var(--bg);
    background: var(--fg-bright);
    font: inherit;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .08em;
    cursor: pointer;
  }
  .cv-request__submit:hover, .cv-request__submit:focus-visible { color: var(--fg-bright); background: transparent; }
  .cv-request__submit:disabled { cursor: wait; opacity: .55; }

  .cv-request__status { min-height: 1.5em; margin: 0; color: var(--fg-dim); font-size: .75rem; line-height: 1.5; }
  .cv-request__status[data-state='error'] { color: var(--accent-orange); }
  .cv-request__status[data-state='success'] { color: var(--fg-bright); }
  .cv-request__return { justify-self: start; font-size: .78rem; }

  @media (max-width: 640px) {
    .cv-request { min-height: 0; align-content: start; }
    .cv-request__submit { width: 100%; }
  }
</style>
