---
import TripLayout from '../layouts/TripLayout.astro';
import { itinerary, allEvents } from '../data/batamTrip';
import '../styles/batam.css';

const notices = [
  { kind: 'info', icon: '🧾', label: 'Seaport tax included', text: 'The Easybook order summary states that seaport tax is included. Keep some MYR and IDR cash for any separate terminal charges.' },
  { kind: 'info', icon: '🕐', label: 'Timezone', text: 'Batam is 1 hour behind Malaysia. MYT = UTC+8 · WIB = UTC+7.' },
  { kind: 'confirmed', icon: '⛴', label: 'Ferry confirmed', text: 'Two-way booking · PPT Ticketing · Easybook order BRKR5HYN. Check in 90 minutes before departure.' },
];
const rooms = [
  ['Room 1', 'Superior Twin Room', 'Aniq · Faisal'],
  ['Room 2', 'Superior Twin Room', 'Intan · Khairrin'],
  ['Room 3', 'Standard Double Room', "Dato' Sri Dedi · Datin Sri Azilah"],
  ['Room 4', 'Standard Double Room', 'Nasuha · Badiuz · Nayla (Infant)'],
];
const cars = [
  ['Car 1 · Toyota Innova · 4 people', "Intan · Khairrin · Dato' Sri Dedi · Datin Sri Azilah", 'Khairrin', '+60172783568'],
  ['Car 2 · Perodua Myvi · 2 people', 'Aniq · Faisal', 'Aniq', '+60192427685'],
  ['Car 3 · Perodua Myvi · 3 people', 'Badiuz · Nasuha · Nayla (Infant)', 'Badiuz', '+60133593495'],
];
const essentials = ['Passport', 'Ferry ticket', 'Travel insurance', 'eSIM installed / downloaded', 'MYR cash', 'IDR cash', 'Phone charger', 'Power bank', 'Medication', 'Hotel booking', 'Supir contact'];
const esimOrderUrl = 'https://uk.trip.com/m/tntorder/orderdetailwkp?orderid=1433814105962330&tripsignature=AAEAAQAHb3JkZXJpZLgkM4pZVj-CMf58nIKCREeF7l5WYjghsP0J000cKpxv-tripsign';
const sharedAlbumUrl = 'https://www.icloud.com/sharedalbum/#B1q5oqs3qrGCIdO';
---

<TripLayout title="Batam 2026 · Trip Portal" description="Private travel companion for the Batam 2026 group trip.">
  <section class="trip-login" id="trip-login" aria-labelledby="trip-login-title">
    <form class="trip-login__card" id="trip-login-form" autocomplete="off">
      <span class="trip-login__mark" aria-hidden="true">B '26</span>
      <p class="eyebrow">PRIVATE TRIP PORTAL ⛴️</p>
      <h1 id="trip-login-title">Welcome aboard!</h1>
      <p>Ready when you are. Batam awaits.</p>
      <label><span>Username</span><input id="trip-username" name="trip-user" type="text" inputmode="text" autocomplete="off" autocapitalize="none" spellcheck="false" data-lpignore="true" data-1p-ignore required /></label>
      <label><span>4-digit PIN</span><input id="trip-pin" name="pin" type="password" inputmode="numeric" autocomplete="current-password" pattern="[0-9]{4}" maxlength="4" required /></label>
      <button type="submit">Open trip portal</button>
      <p class="trip-login__message" id="trip-login-message" role="status">Checking this device…</p>
    </form>
  </section>

  <main class="trip-shell" id="trip-app" hidden>
    <header class="trip-hero" id="top">
      <!-- <div class="hero-topline"><span class="eyebrow">GROUP TRIP · PRIVATE LINK</span><span class="status-dot">Plan active</span></div> -->
      <h1>BATAM <span>2026</span></h1>
      <p class="trip-date">🏙️ 🇲🇾 &nbsp; 28–30 August &nbsp; 🇮🇩 🛕</p>
      <!-- <div class="trip-stats" aria-label="Trip summary"><span>3 Days · 2 Nights</span><span>9 Travellers</span></div> -->
      <div class="route"><span>Sungai Buloh</span><b class="route-mode--forward" role="img" aria-label="Travel by car" title="By car">🚗</b><span>Pasir Gudang</span><b class="route-mode--forward" role="img" aria-label="Travel by ferry" title="By ferry">⛴️</b><span>Batam</span></div>
    </header>

    <nav class="section-switcher" aria-label="Quick access">
      <div class="section-switcher__scroll">
        <button class="active" type="button" data-view="home" aria-pressed="true">Home</button>
        <button type="button" data-view="profile" aria-pressed="false">Profile</button>
        <button type="button" data-view="itinerary" aria-pressed="false">Plan</button>
        <button type="button" data-view="transport" aria-pressed="false">Transport</button>
        <button type="button" data-view="hotel" aria-pressed="false">Hotel</button>
        <button type="button" data-view="payments" aria-pressed="false">Cost</button>
        <button type="button" data-view="insurance" aria-pressed="false">Insurance</button>
        <button type="button" data-view="esim" aria-pressed="false">eSIM</button>
        <button type="button" data-view="photos" aria-pressed="false">Photos</button>
        <button type="button" data-view="emergency" aria-pressed="false">Emergency</button>
      </div>
      <span class="section-switcher__hint" aria-hidden="true"> <b>→</b></span>
    </nav>

    <div class="trip-content" id="trip-content">
    <section class="profile-welcome panel" id="profile-welcome" data-home-view aria-live="polite">
      <div><p class="eyebrow">YOUR TRIP</p><h2 id="profile-greeting">Welcome to Batam!</h2><p id="profile-welcome-note">Your travel details are ready on this device.</p></div>
      <button type="button" data-open-profile>View profile</button>
    </section>
    <section class="panel section-documents" id="documents-immigration" data-home-view hidden><div class="profile-documents__head"><div><p class="eyebrow">OFFICIAL DOCUMENTS</p><h3>Your immigration files</h3></div><span data-document-count></span></div><div class="profile-document-list" data-document-list="Immigration"></div></section>
    <section class="top-essentials" id="essentials" data-home-view aria-labelledby="essentials-title">
      <div class="section-heading"><h2 id="essentials-title">Trip checklist</h2></div>
      <div class="panel info-disclosure info-disclosure--static"><div class="info-disclosure__header"><div><span class="eyebrow">BEFORE WE GO</span><strong>{essentials.length} essentials to prepare</strong></div></div><div class="info-disclosure__content checklist">{essentials.map((item) => <label><input type="checkbox" /><span>{item}</span></label>)}</div></div>
    </section>

    <section class="panel home-fx" data-home-view>
      <div class="home-fx__top">
        <div>
          <p class="eyebrow">QUICK CURRENCY</p>
          <h2>IDR → MYR</h2>
        </div>
        <button type="button" data-view="payments">Open full calculator →</button>
      </div>
      <div class="home-fx__amount">
        <span>Rp</span>
        <input id="home-fx-idr" type="text" inputmode="decimal" value="100000" aria-label="IDR amount"/>
        <small>IDR</small>
      </div>
      <div class="home-fx__result">
        ≈ <strong id="home-fx-myr">RM 22.88</strong>
      </div>
      <div class="fx-calculator" id="home-fx-calculator">
        <button type="button" data-home-fx-key="clear">C</button>
        <button type="button" data-home-fx-key="backspace">⌫</button>
        <button type="button" data-home-fx-key="divide">÷</button>
        <button type="button" data-home-fx-key="multiply">×</button>
        <button type="button" data-home-fx-key="7">7</button>
        <button type="button" data-home-fx-key="8">8</button>
        <button type="button" data-home-fx-key="9">9</button>
        <button type="button" data-home-fx-key="subtract">−</button>
        <button type="button" data-home-fx-key="4">4</button>
        <button type="button" data-home-fx-key="5">5</button>
        <button type="button" data-home-fx-key="6">6</button>
        <button type="button" data-home-fx-key="add">+</button>
        <button type="button" data-home-fx-key="1">1</button>
        <button type="button" data-home-fx-key="2">2</button>
        <button type="button" data-home-fx-key="3">3</button>
        <button type="button" data-home-fx-key="equals">=</button>
        <button type="button" data-home-fx-key="0">0</button>
        <button type="button" data-home-fx-key="00">00</button>
        <button type="button" data-home-fx-key="000">000</button>
        <button type="button" data-home-fx-key="decimal">.</button>
      </div>
    </section>

    <section class="up-next" data-home-view aria-labelledby="current-title">
      <div><p class="eyebrow">CURRENT</p><h2 id="current-title">Preparing for departure</h2><p id="current-time">Departure · 27 Aug at 10:00 PM MYT</p></div>
      <div class="next-icon" aria-hidden="true">→</div>
      <p class="next-detail" id="current-detail">Get ready and complete the remaining checklist.</p>
      <div class="future-event" id="next-event">
        <p class="eyebrow">UP NEXT</p>
        <div><h3 id="next-title">Depart Sungai Buloh</h3><p id="next-time">27 Aug · 10:00 PM MYT</p></div>
      </div>
      <div class="future-event" id="later-event">
        <p class="eyebrow">LATER</p>
        <div><h3 id="later-title">Arrive near Pasir Gudang terminal</h3><p id="later-time">28 Aug · 4:00 AM MYT</p></div>
      </div>
    </section>

    <section class="notice-stack" data-home-view aria-label="Important notices">
      {notices.map((notice) => <article class={`notice notice--${notice.kind}`}><span class="notice-mark" aria-hidden="true">{notice.icon}</span><div><h3>{notice.label}</h3><p>{notice.text}</p></div></article>)}
    </section>

    <section class="section-block" id="itinerary" data-section-view="itinerary" aria-labelledby="itinerary-title">
      <div class="section-heading"><p class="eyebrow">THE FULL PLAN</p><h2 id="itinerary-title">Itinerary</h2></div>
      <div class="days">
        {itinerary.map((day, index) => (
          <article class="day-card" data-date={day.date}>
            <div class="day-card__header"><div><span>{day.label} · {new Date(`${day.date}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' })}</span><h3>{day.title}</h3></div></div>
            <div class="timeline">
              {day.events.map((event) => (
                <article class="event" id={event.title === 'Harbour Bay Downtown' ? 'place-harbour-bay' : event.title === 'Grand Batam Mall' ? 'place-grand-batam' : event.title === 'Ferry check-in' ? 'place-batam-centre-terminal' : undefined} data-datetime={event.datetime}>
                  <div class="event-time"><time datetime={event.datetime}>{event.time}</time><span>{event.timezone}</span></div>
                  <div class="event-copy"><div class="event-title-row"><h4>{event.title}</h4>{event.status && <span class={`badge badge--${event.status}`}>{event.status === 'tbc' ? 'TBC' : event.status}</span>}</div>{event.description && <p>{event.description}</p>}{event.meta && <small>{event.meta}</small>}</div>
                </article>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block traveller-profile" id="profile" data-section-view="profile" aria-labelledby="profile-title">
      <div class="section-heading"><p class="eyebrow">TRAVELLER DETAILS</p><h2 id="profile-title">My profile</h2><span class="stage-note">Personal information for this login</span></div>
      <div class="profile-members" id="profile-members" aria-live="polite"></div>
      <a class="profile-admin-link" id="profile-admin-link" href="/batam/admin" hidden>Open trip admin ↗</a>
      <button class="profile-lock" id="profile-lock" type="button">Sign out & remove offline data</button>
    </section>

    <section class="section-block transport-stage" id="crew" data-stage="1" data-section-view="transport">
      <div class="section-heading"><p class="eyebrow">TRANSPORT · 1 OF 3</p><h2>Road to Pasir Gudang</h2><span class="stage-note">Three cars, one overnight convoy</span></div>
      <div class="panel info-disclosure info-disclosure--static"><div class="info-disclosure__header"><div><span class="eyebrow">CAR ALLOCATION</span><strong>9 travellers · 3 cars</strong></div></div><div class="info-disclosure__content compact-grid car-grid">{cars.map(([car, people, pic, phone]) => <article class="compact-card car-card"><h3>{car}</h3><p>{people}</p><a class="car-pic" href={`tel:${phone}`}><span>PIC · {pic}</span><b>{phone}</b></a></article>)}</div></div>
    </section>

    <section class="section-block transport-stage" id="ferry" data-stage="2" data-section-view="transport">
      <div class="section-heading"><p class="eyebrow">TRANSPORT · 2 OF 3</p><h2>Crossing the border</h2><span class="stage-note">Pasir Gudang ↔ Batam Centre</span></div>
      <div class="two-col">
        <article class="panel booking-card"><div class="card-top"><span class="badge badge--confirmed">Outbound · Confirmed</span><span>28 Aug 2026</span></div><h3>Pasir Gudang <b>→</b> Batam Centre</h3><p class="big-time">8:45 AM <small>MYT</small></p><p class="equivalent">Be at the counter by 7:15 AM MYT</p><dl><div><dt>Depart</dt><dd>Pelabuhan Pasir Gudang</dd></div><div><dt>Arrive</dt><dd>Batam Centre</dd></div></dl></article>
        <article class="panel booking-card"><div class="card-top"><span class="badge badge--confirmed">Return · Confirmed</span><span>30 Aug 2026</span></div><h3>Batam Centre <b>→</b> Pasir Gudang</h3><p class="big-time">11:20 AM <small>WIB</small></p><p class="equivalent">12:20 PM MYT · counter by 9:50 AM WIB</p><dl><div><dt>Depart</dt><dd>Batam Centre</dd></div><div><dt>Arrive</dt><dd>Pelabuhan Pasir Gudang</dd></div></dl></article>
      </div>
      <article class="panel ferry-order-card"><div class="card-top"><div><p class="eyebrow">EASYBOOK ORDER</p><h3>BRKR5HYN</h3></div><span class="badge badge--confirmed">Confirmed</span></div><dl><div><dt>Trip</dt><dd>Return · 9 passengers</dd></div><div><dt>Operator</dt><dd>PPT Ticketing Sdn Bhd</dd></div><div><dt>Order code</dt><dd>EBMY-ON-2607229822</dd></div><div><dt>Seaport tax</dt><dd>Included</dd></div><div><dt>Luggage</dt><dd>15 kg per passenger</dd></div></dl><a class="ferry-support" href="https://wa.me/60189691080" target="_blank" rel="noopener noreferrer">Message Easybook on WhatsApp</a></article>
      <article class="panel info-disclosure info-disclosure--static ferry-guide"><div class="info-disclosure__header"><div><span class="eyebrow">BEFORE BOARDING</span><strong>Check-in & document reminders</strong></div></div><div class="info-disclosure__content"><ul><li>Check in at the ferry counter 90 minutes before departure.</li><li>Bring each traveller’s passport and required travel documents.</li><li>Keep the order summary available; print it if requested, as a screenshot may not be accepted.</li><li>The booking summary does not state an estimated arrival time or assigned seats.</li><li>Schedules can change—verify with the operator before travelling.</li></ul><p>The original order summary is not attached here because it contains travellers’ passport and identity details.</p></div></article>
    </section>

      <article class="panel section-documents" id="documents-ferry" hidden><div class="profile-documents__head"><div><p class="eyebrow">OFFICIAL DOCUMENTS</p><h3>Ferry tickets</h3></div><span data-document-count></span></div><div class="profile-document-list" data-document-list="Ferry"></div></article>
    <section class="section-block" id="hotel" data-section-view="hotel">
      <div class="section-heading"><p class="eyebrow">2-NIGHT STAY</p><h2>Hotel</h2></div>
      <article class="panel hotel-card">
        <div class="hotel-card__top"><div><span class="badge badge--confirmed">4 rooms confirmed · 28–30 August</span><h3>Lovina Inn Nagoya Batam</h3><p>Budget-friendly hotel in central Lubuk Baja, Batam.</p></div><span class="hotel-rating">2-star</span></div>
        <address>Komplek Sri Usaha, Blk. H No. 8, Lubuk Baja Kota, Kota Batam, Kepulauan Riau 29444, Indonesia</address>
        <div class="hotel-details"><div class="hotel-details__header">Nearby places & amenities</div><div class="hotel-details__content">
          <div class="hotel-location-grid">
            <div><span>Walkable</span><strong>Nagoya Citywalk</strong><small>≈ 240 m · about 3–5 min</small></div>
            <div><span>Walkable</span><strong>Nagoya Hill Mall</strong><small>≈ 300–500 m · about 4–7 min</small></div>
            <div><span>Day 1 itinerary</span><strong>Harbour Bay</strong><small>≈ 1.7–2.5 km · about 8 min by car</small><a class="hotel-itinerary-link" href="#place-harbour-bay">See in itinerary →</a></div>
            <div><span>Day 2 itinerary</span><strong>Grand Batam Mall</strong><small>≈ 1.5–1.9 km · short drive</small><a class="hotel-itinerary-link" href="#place-grand-batam">See in itinerary →</a></div>
            <div><span>Day 3 itinerary</span><strong>Batam Centre terminal</strong><small>≈ 5.5–8 km · about 10–16 min by car</small><a class="hotel-itinerary-link" href="#place-batam-centre-terminal">See in itinerary →</a></div>
          </div>
          <ul class="amenity-list" aria-label="Hotel amenities"><li>Free Wi-Fi</li><li>Basic breakfast</li><li>24-hour front desk</li><li>Air conditioning</li><li>Lift access</li><li>Halal dining</li><li>Free parking</li></ul>
        </div></div>
        <div class="hotel-details booking-confirmation-details"><div class="hotel-details__header">Booking & check-in details</div><div class="hotel-details__content"><dl class="hotel-booking-facts"><div><dt>Check-in</dt><dd>28 Aug · from 3:00 PM</dd></div><div><dt>Check-out</dt><dd>30 Aug · by 12:00 PM</dd></div><div><dt>Booking confirmation</dt><dd>5440.336.138 · 6085.884.190</dd></div><div><dt>Meal plan</dt><dd>No meals included</dd></div></dl><p class="hotel-arrival-note">Arrive before 6:00 PM. If the group will arrive later, contact the hotel in advance and present the booking confirmation with valid ID at check-in.</p></div></div>
        <div class="hotel-actions"><a href="tel:+62778421789">Call hotel</a><a class="hotel-action--secondary" href="https://www.lovinainn.com/" target="_blank" rel="noopener noreferrer">Official website</a></div>
      </article>
      <div class="panel info-disclosure info-disclosure--static"><div class="info-disclosure__header"><div><span class="eyebrow">ROOM ALLOCATION</span><strong>4 rooms · 9 travellers</strong></div></div><div class="info-disclosure__content compact-grid">{rooms.map(([room, type, guests]) => <article class="compact-card"><span>{room}</span><h3>{type}</h3><p>{guests}</p></article>)}</div></div>
    </section>

      <article class="panel section-documents" id="documents-hotel" hidden><div class="profile-documents__head"><div><p class="eyebrow">OFFICIAL DOCUMENTS</p><h3>Hotel booking</h3></div><span data-document-count></span></div><div class="profile-document-list" data-document-list="Hotel"></div></article>
    <section class="section-block transport-stage" id="supir" data-stage="3" data-section-view="transport">
      <div class="section-heading"><p class="eyebrow">TRANSPORT · 3 OF 3</p><h2>Playing tourist</h2><span class="stage-note">Two cars and a local who knows the way</span></div>
      <article class="panel supir-profile"><div class="supir-avatar" aria-hidden="true">CR</div><div><span class="badge badge--confirmed">Driver confirmed</span><h3>Christina Rahmawati</h3><p>Local driver · Batam</p></div><div class="supir-contact"><a href="https://wa.me/6285232661117" target="_blank" rel="noopener noreferrer">WhatsApp</a><a href="tel:+6285232661117">Call</a></div><a class="supir-social" href="https://www.tiktok.com/@dlapandlapan.tour" target="_blank" rel="noopener noreferrer">TikTok profile ↗</a></article>
      <article class="panel feature-card transport"><div><span class="badge badge--confirmed">2 cars · Booked for 2 days</span><h3>28–29 August · 9:00 AM–10:00 PM</h3><div class="transport-rate"><div><span>Daily rate · 2 cars</span><strong>IDR 1,500,000</strong><small>≈ RM343.27</small></div><div><span>2-day total</span><strong>IDR 3,000,000</strong><small>≈ RM686.54</small></div></div><p class="price">IDR 375,000 <span>≈ RM85.82</span><small>per paying adult · 8 adults · Nayla excluded</small></p><p>Pickup at Batam Centre ferry terminal is confirmed. Car models are still pending; registration plates are not required for this portal.</p><p class="conversion-note">MYR estimates use the Wise mid-market rate checked 25 Aug 2026: RM1 = IDR 4,369.71.</p></div><div class="actions"><a href="https://wa.me/6285232661117" target="_blank" rel="noopener">WhatsApp</a><a href="tel:+6285232661117">Call</a></div></article>
    </section>

    <section class="section-block" id="esim" data-section-view="esim">
      <div class="section-heading"><p class="eyebrow">CONNECTIVITY</p><h2>eSIM</h2></div>
      <article class="panel readiness esim-summary"><div><span class="ready-check">✓</span><div><span class="badge badge--confirmed">Allocated</span><h3>Trip.com eSIM order</h3><p>Each supported traveller has an individual eSIM document assigned to their login. Badiuz uses roaming and Nayla does not require a phone.</p></div></div><a class="esim-order-link" href={esimOrderUrl} target="_blank" rel="noopener noreferrer">Open shared Trip.com order ↗</a></article>
      <!-- <div class="esim-grid" aria-label="Traveller connectivity status">
        <article><span class="badge badge--confirmed">Own roaming</span><strong>Badiuz</strong></article>
        <article><span class="badge badge--tbc">Not required</span><strong>Nayla</strong><small>1 year old · no phone</small></article>
      </div> -->
      <article class="panel info-disclosure info-disclosure--static esim-guide"><div class="info-disclosure__header"><div><span class="eyebrow">SETUP GUIDE</span><strong>Before eSIM installation</strong></div></div><div class="info-disclosure__content"><ol><li>Use a stable internet connection.</li><li>Install on the phone that will use it—the eSIM cannot be transferred after installation.</li><li>Activate after arriving at the destination.</li><li>Turn on the eSIM line and data roaming.</li></ol></div></article>
    </section>

      <article class="panel section-documents" id="documents-esim" hidden><div class="profile-documents__head"><div><p class="eyebrow">OFFICIAL DOCUMENTS</p><h3>eSIM installation</h3></div><span data-document-count></span></div><div class="profile-document-list" data-document-list="eSIM"></div></article>
    <section class="section-block" id="insurance" data-section-view="insurance">
      <div class="section-heading"><p class="eyebrow">COVERAGE</p><h2>Insurance</h2></div>
      <article class="panel insurance-summary" data-policy="zurich">
        <div class="card-top"><span class="badge badge--confirmed">6 travellers covered</span><span>28–30 Aug 2026</span></div>
        <h3>Zurich Travel Takaful</h3><p>International · Basic Plan · Southeast Asia · Group return cover</p>
        <div class="insurance-actions"><a href="/trip-files/zt-2026-6p-a8f31c7d92e64b0f.pdf" target="_blank" rel="noopener">Open protected policy PDF</a><a class="insurance-action--secondary" href="tel:1300888622">Call Zurich customer care</a></div>
        <details class="insurance-details"><summary>Policy details, covered names & benefits <span aria-hidden="true">+</span></summary><div class="insurance-details__content"><dl><div><dt>Certificate</dt><dd>PZTIMYGT038514</dd></div><div><dt>Travel Assist</dt><dd>Included</dd></div><div><dt>Total contribution</dt><dd>RM140.29</dd></div></dl><div class="covered-people"><span>People covered</span><ul><li>Muhammad Amrun Aniq bin Mohamed Saidi</li><li>Azilah binti Abd Aziz</li><li>Dedi bin Jalinas</li><li>Khairrin Naim bin Redzuan</li><li>Intan Nurshahira binti Razaly</li><li>Muhammad Faisal bin Hasan</li></ul></div><div class="benefit-grid" aria-label="Key insurance benefits"><article><span>Overseas medical</span><strong>Up to RM100,000</strong></article><article><span>Medical evacuation</span><strong>Unlimited</strong></article><article><span>Personal accident</span><strong>RM150,000</strong></article><article><span>Personal liability</span><strong>RM750,000</strong></article><article><span>Travel cancellation</span><strong>Up to RM20,000</strong></article><article><span>Baggage & effects</span><strong>Up to RM3,000</strong></article></div><p class="policy-note">The attached policy remains password-protected; its password is not displayed or stored on this page. Coverage remains subject to the certificate terms, conditions and exclusions. Zurich’s listed number is customer care, not a confirmed overseas emergency hotline.</p></div></details>
      </article>
      <article class="panel insurance-summary takaful-summary" data-policy="takaful">
        <div class="card-top"><span class="badge badge--confirmed">3 travellers covered</span><span>28–30 Aug 2026</span></div>
