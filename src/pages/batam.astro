  <script>
    import * as pdfjs from 'pdfjs-dist/legacy/build/pdf.mjs';
    import pdfWorkerUrl from 'pdfjs-dist/legacy/build/pdf.worker.min.mjs?url';

    pdfjs.GlobalWorkerOptions.workerSrc = pdfWorkerUrl;

    const login = document.getElementById('trip-login');
    const loginForm = document.getElementById('trip-login-form');
    const loginMessage = document.getElementById('trip-login-message');
    const app = document.getElementById('trip-app');
    const cacheKey = 'batam.profile.v1';
    const tokenKey = 'batam.session.v1';
    let currentProfile;
    const documentCacheName = (profile) => `batam-documents-${profile.username}-v2`;
    const offlineDocumentUrl = (profile, documentData) => `/batam/offline/${profile.username}/${documentData.id}.pdf`;
    const updateNetworkStatus = () => document.documentElement.classList.toggle('is-offline', !navigator.onLine);
    const cacheDocuments = async (profile, token) => {
      const status = document.getElementById('offline-pack-status');
      if (!('caches' in window)) { if (status) status.textContent = 'Offline files unsupported'; return; }
      const activeCache = documentCacheName(profile);
      const oldCaches = (await caches.keys()).filter((name) => name.startsWith(`batam-documents-${profile.username}-`) && name !== activeCache);
      await Promise.all(oldCaches.map((name) => caches.delete(name)));
      const cache = await caches.open(activeCache);
      if (!(await cache.match(pdfWorkerUrl)) && navigator.onLine) {
        try {
          const workerResponse = await fetch(pdfWorkerUrl, { cache: 'reload' });
          if (workerResponse.ok) await cache.put(pdfWorkerUrl, workerResponse);
        } catch { /* PDF previews remain available after the next successful sync */ }
      }
      let saved = 0;
      for (const documentData of profile.documents) {
        const key = offlineDocumentUrl(profile, documentData);
        if (await cache.match(key)) { saved += 1; continue; }
        if (!navigator.onLine || !token) continue;
        try {
          if (status) status.textContent = `Saving files ${saved + 1}/${profile.documents.length}…`;
          const response = await fetch(`/api/batam/document?id=${encodeURIComponent(documentData.id)}`, { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' });
          if (response.ok) { await cache.put(key, response); saved += 1; }
        } catch { /* keep the rest of the portal usable */ }
      }
      if (status) status.textContent = saved === profile.documents.length ? `✓ ${saved} files ready offline` : `${saved}/${profile.documents.length} files offline`;
      document.querySelectorAll('[data-document-status]').forEach(async (node) => {
        const isReady = !!(await cache.match(node.getAttribute('data-document-status') || ''));
        node.textContent = isReady ? 'Ready offline' : 'Online required';
        const button = node.parentElement?.querySelector('button');
        if (button) button.hidden = !isReady;
      });
    };
    const openDocument = async (documentData, card, button) => {
      if (!currentProfile || !('caches' in window)) return;
      const existing = card.querySelector('.document-viewer');
      if (existing) { existing.remove(); button.textContent = 'Preview'; return; }
      const cache = await caches.open(documentCacheName(currentProfile));
      const key = offlineDocumentUrl(currentProfile, documentData);
      let response = await cache.match(key);
      if (!response && navigator.onLine) { await cacheDocuments(currentProfile, localStorage.getItem(tokenKey)); response = await cache.match(key); }
      if (!response) return window.alert('This file is not saved yet. Connect to the internet once and try again.');
      const bytes = await response.arrayBuffer();
      const contentType = response.headers.get('Content-Type') || 'application/pdf';
      const viewer = document.createElement('div'); viewer.className = 'document-viewer';
      const toolbar = document.createElement('div'); toolbar.className = 'document-viewer__toolbar';
      const toolbarLabel = document.createElement('strong'); toolbarLabel.textContent = documentData.title;
      const controls = document.createElement('div'); controls.className = 'document-viewer__controls';
      const zoomOut = document.createElement('button'); zoomOut.type = 'button'; zoomOut.textContent = '−'; zoomOut.setAttribute('aria-label', 'Zoom out');
      const zoomLabel = document.createElement('span'); zoomLabel.className = 'document-viewer__zoom'; zoomLabel.textContent = 'Fit';
      const zoomIn = document.createElement('button'); zoomIn.type = 'button'; zoomIn.textContent = '+'; zoomIn.setAttribute('aria-label', 'Zoom in');
      const fit = document.createElement('button'); fit.type = 'button'; fit.textContent = 'Fit'; fit.setAttribute('aria-label', 'Fit document to width');
      const fullscreen = document.createElement('button'); fullscreen.type = 'button'; fullscreen.textContent = 'Full screen';
      const stage = document.createElement('div'); stage.className = 'document-viewer__stage';
      let zoom = 1;
      let disposed = false;
      let imageUrl;
      let pdfDocument;
      let resizeTimer;
      let renderVersion = 0;
      let viewerAnchor;

      const setExpanded = (expanded) => {
        if (expanded && !viewer.classList.contains('is-expanded')) {
          viewerAnchor = document.createComment('document-viewer-position');
          viewer.before(viewerAnchor);
          document.body.append(viewer);
        } else if (!expanded && viewer.classList.contains('is-expanded') && viewerAnchor?.parentNode) {
          viewerAnchor.replaceWith(viewer);
          viewerAnchor = undefined;
        }
        viewer.classList.toggle('is-expanded', expanded);
        document.documentElement.classList.toggle('has-document-viewer', expanded);
        fullscreen.textContent = expanded ? 'Exit' : 'Full screen';
        fullscreen.setAttribute('aria-label', expanded ? 'Exit full screen preview' : 'Open full screen preview');
      };
      const updateZoomLabel = () => { zoomLabel.textContent = zoom === 1 ? 'Fit' : `${Math.round(zoom * 100)}%`; };

      if (contentType.startsWith('image/')) {
        imageUrl = URL.createObjectURL(new Blob([bytes], { type: contentType }));
        const preview = document.createElement('img');
        preview.src = imageUrl;
        preview.alt = documentData.title;
        preview.className = 'document-viewer__image';
        preview.addEventListener('error', () => { stage.innerHTML = '<p class="document-viewer__error">This image could not be displayed. Reconnect once to refresh its offline copy.</p>'; }, { once: true });
        stage.append(preview);
        const renderImage = () => { preview.style.width = `${zoom * 100}%`; updateZoomLabel(); };
        zoomOut.addEventListener('click', () => { zoom = Math.max(.5, zoom - .25); renderImage(); });
        zoomIn.addEventListener('click', () => { zoom = Math.min(4, zoom + .25); renderImage(); });
        fit.addEventListener('click', () => { zoom = 1; renderImage(); stage.scrollTo(0, 0); });
      } else {
        stage.setAttribute('aria-label', `${documentData.title} PDF preview`);
        try {
          pdfDocument = await pdfjs.getDocument({ data: new Uint8Array(bytes) }).promise;
        } catch {
          viewer.remove();
          button.textContent = 'Preview';
          return window.alert('This PDF could not be previewed. Please try downloading it again while online.');
        }
        const renderPdf = async () => {
          const version = ++renderVersion;
          const availableWidth = Math.max(240, stage.clientWidth - 20);
          const pages = document.createElement('div'); pages.className = 'document-viewer__pages';
          stage.replaceChildren(pages);
          try {
            for (let pageNumber = 1; pageNumber <= pdfDocument.numPages; pageNumber += 1) {
              if (disposed || version !== renderVersion) return;
              const page = await pdfDocument.getPage(pageNumber);
              const natural = page.getViewport({ scale: 1 });
              const viewport = page.getViewport({ scale: (availableWidth / natural.width) * zoom });
              const ratio = Math.min(window.devicePixelRatio || 1, 2);
              const pageShell = document.createElement('div'); pageShell.className = 'document-viewer__page';
              pageShell.style.width = `${Math.floor(viewport.width)}px`;
              pageShell.style.height = `${Math.floor(viewport.height)}px`;
              const canvas = document.createElement('canvas');
              canvas.width = Math.floor(viewport.width * ratio);
              canvas.height = Math.floor(viewport.height * ratio);
              canvas.style.width = `${Math.floor(viewport.width)}px`;
              canvas.style.height = `${Math.floor(viewport.height)}px`;
              const context = canvas.getContext('2d', { alpha: false });
              if (!context) continue;
              const textLayerElement = document.createElement('div'); textLayerElement.className = 'document-viewer__text-layer';
              pageShell.append(canvas, textLayerElement); pages.append(pageShell);
              await page.render({ canvasContext: context, viewport, transform: ratio === 1 ? undefined : [ratio, 0, 0, ratio, 0, 0] }).promise;
              page.getTextContent().then((textContent) => new pdfjs.TextLayer({ textContentSource: textContent, container: textLayerElement, viewport }).render()).catch(() => { /* Canvas preview remains usable when a PDF has no extractable text. */ });
            }
          } catch {
            if (!disposed && version === renderVersion && pages.childElementCount === 0) {
              stage.innerHTML = '<p class="document-viewer__error">This PDF could not be rendered on this device. Reconnect once to refresh its offline copy.</p>';
            }
          }
          updateZoomLabel();
        };
        const rerender = () => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(renderPdf, 100); };
        zoomOut.addEventListener('click', () => { zoom = Math.max(.5, zoom - .25); rerender(); });
        zoomIn.addEventListener('click', () => { zoom = Math.min(3, zoom + .25); rerender(); });
        fit.addEventListener('click', () => { zoom = 1; stage.scrollTo(0, 0); rerender(); });
        const resizeObserver = new ResizeObserver(rerender);
        resizeObserver.observe(stage);
        viewer.addEventListener('documentviewerdispose', () => resizeObserver.disconnect(), { once: true });
        requestAnimationFrame(renderPdf);
      }
      const dispose = () => {
        disposed = true; renderVersion += 1; clearTimeout(resizeTimer);
        setExpanded(false); document.removeEventListener('keydown', onKeydown);
        viewer.dispatchEvent(new Event('documentviewerdispose'));
        pdfDocument?.destroy();
        if (imageUrl) URL.revokeObjectURL(imageUrl);
        viewer.remove(); button.textContent = 'Preview';
      };
      fullscreen.addEventListener('click', dispose);
      const onKeydown = (event) => { if (event.key === 'Escape' && viewer.classList.contains('is-expanded')) dispose(); };
      document.addEventListener('keydown', onKeydown);
      controls.append(zoomOut, zoomLabel, zoomIn, fit, fullscreen);
      toolbar.append(toolbarLabel, controls); viewer.append(toolbar, stage); card.append(viewer); button.textContent = 'Close preview';
      setExpanded(true);
      card.addEventListener('toggle', () => { if (!card.open) dispose(); }, { once: true });
    };

    const setLoginMessage = (message, error = false) => {
      if (!loginMessage) return;
      loginMessage.textContent = message;
      loginMessage.classList.toggle('is-error', error);
    };
    const showLogin = (message = 'Enter your details to continue.') => {
      if (login) login.hidden = false;
      if (app) app.hidden = true;
      setLoginMessage(message);
    };
    const fact = (label, value) => {
      const item = document.createElement('div');
      const term = document.createElement('dt');
      const detail = document.createElement('dd');
      term.textContent = label; detail.textContent = value;
      item.append(term, detail);
      return item;
    };
    const disclosureContent = new WeakMap();
    const makeDisclosure = (container, trigger, content, open = false, exclusive = false) => {
      if (!container || !trigger || !content || container.dataset.disclosureReady === 'true') return;
      container.dataset.disclosureReady = 'true'; container.classList.add('ui-disclosure');
      content.classList.add('ui-disclosure__content');
      disclosureContent.set(container, content);
      trigger.classList.add('ui-disclosure__trigger'); trigger.setAttribute('role', 'button'); trigger.setAttribute('tabindex', '0');
      const setOpen = (next) => {
        if (next && exclusive) {
          container.parentElement?.querySelectorAll(':scope > .ui-disclosure.is-open').forEach((other) => {
            if (other === container) return;
            other.classList.remove('is-open');
            const otherTrigger = other.querySelector(':scope > .ui-disclosure__trigger');
            const otherContent = disclosureContent.get(other);
            if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
            if (otherContent instanceof HTMLElement) otherContent.hidden = true;
          });
        }
        container.classList.toggle('is-open', next); content.hidden = !next; trigger.setAttribute('aria-expanded', String(next));
      };
      const toggle = () => {
        const next = !container.classList.contains('is-open');
        setOpen(next);
        if (next && exclusive) {
          window.requestAnimationFrame(() => {
            const scroller = document.getElementById('trip-content');
            if (!scroller) return;
            const scrollerTop = scroller.getBoundingClientRect().top;
            const cardTop = container.getBoundingClientRect().top;
            scroller.scrollTo({ top: Math.max(0, scroller.scrollTop + cardTop - scrollerTop - 4), behavior: 'smooth' });
          });
        }
      };
      trigger.addEventListener('click', toggle);
      trigger.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggle(); } });
      setOpen(open);
    };
    const renderProfile = (profile) => {
      currentProfile = profile;
      const greeting = document.getElementById('profile-greeting');
      if (greeting) greeting.textContent = profile.greeting;
      const note = document.getElementById('profile-welcome-note');
      if (note) note.textContent = profile.members.length > 1 ? `${profile.members.length} family profiles · shared access` : 'Your trip overview and personal travel details';
      const adminLink = document.getElementById('profile-admin-link');
      if (adminLink) adminLink.hidden = profile.role !== 'admin';
      const usesTakaful = profile.members.some((member) => member.insurance.startsWith('Takaful Malaysia'));
