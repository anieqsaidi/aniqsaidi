---
import TripLayout from '../layouts/TripLayout.astro';
import { itinerary, allEvents } from '../data/batamTrip';
import '../styles/batam.css';

const notices = [
  { kind: 'info', label: 'Seaport tax included', text: 'The Easybook order summary states that seaport tax is included. Keep some MYR and IDR cash for any separate terminal charges.' },
  { kind: 'info', label: 'Timezone', text: 'Batam is 1 hour behind Malaysia. MYT = UTC+8 · WIB = UTC+7.' },
  { kind: 'confirmed', label: 'Ferry confirmed', text: 'Two-way booking · PPT Ticketing · Easybook order BRKR5HYN. Check in 90 minutes before departure.' },
];
const rooms = [
  ['Room 1', 'Superior Twin Room', 'Aniq · Faisal'],
  ['Room 2', 'Superior Twin Room', 'Intan · Khairrin'],
  ['Room 3', 'Deluxe Room', 'Nasuha · Badiuz · Nayla (Infant)'],
  ['Room 4', 'Deluxe Room', "Dato' Sri Dedi · Datin Sri Azilah"],
];
const cars = [
  ['Car 1 · Toyota Innova · 4 people', "Intan · Khairrin · Dato' Sri Dedi · Datin Sri Azilah", 'Khairrin', '+60172783568'],
  ['Car 2 · Perodua Myvi · 2 people', 'Aniq · Faisal', 'Aniq', '+60192427685'],
  ['Car 3 · Perodua Myvi · 3 people', 'Badiuz · Nasuha · Nayla (Infant)', 'Badiuz', '+60133593495'],
];
const essentials = ['Passport', 'All Indonesia arrival declaration', 'Visa Exemption for autogate', 'Ferry ticket', 'Travel insurance', 'eSIM installed / downloaded', 'MYR cash', 'IDR cash', 'Phone charger', 'Power bank', 'Medication', 'Hotel booking', 'Supir contact'];
const esimOrderUrl = 'https://uk.trip.com/m/tntorder/orderdetailwkp?orderid=1433814105962330&tripsignature=AAEAAQAHb3JkZXJpZLgkM4pZVj-CMf58nIKCREeF7l5WYjghsP0J000cKpxv-tripsign';
const sharedAlbumUrl = 'https://www.icloud.com/sharedalbum/#B1q5oqs3qrGCIdO';
---

<TripLayout title="Batam 2026 · Trip Portal" description="Private travel companion for the Batam 2026 group trip.">
  <main class="trip-shell">
    <header class="trip-hero" id="top">
      <div class="hero-topline"><span class="eyebrow">GROUP TRIP · PRIVATE LINK</span><span class="status-dot">Plan active</span></div>
      <h1>BATAM <span>2026</span></h1>
      <p class="trip-date">28–30 August 2026</p>
      <div class="trip-stats" aria-label="Trip summary"><span>3 Days · 2 Nights</span><span>9 Travellers</span></div>
      <div class="route"><span>Sungai Buloh</span><b>→</b><span>Pasir Gudang</span><b>→</b><span>Batam</span></div>
      <p class="departure-note"><b>Status:</b> <span id="trip-status" aria-live="polite">Awaiting departure · 27 Aug at approximately 10:00 PM MYT</span></p>
    </header>

    <nav class="section-switcher" aria-label="Quick access">
      <div class="section-switcher__scroll">
        <button class="active" type="button" data-view="home" aria-pressed="true">Home</button>
        <button type="button" data-view="itinerary" aria-pressed="false">Plan</button>
        <button type="button" data-view="ferry" aria-pressed="false">Ferry</button>
        <button type="button" data-view="hotel" aria-pressed="false">Hotel</button>
        <button type="button" data-view="crew" aria-pressed="false">Crew</button>
        <button type="button" data-view="supir" aria-pressed="false">Supir</button>
        <button type="button" data-view="insurance" aria-pressed="false">Insurance</button>
        <button type="button" data-view="esim" aria-pressed="false">eSIM</button>
        <button type="button" data-view="photos" aria-pressed="false">Photos</button>
        <button type="button" data-view="payments" aria-pressed="false">Payments</button>
        <button type="button" data-view="emergency" aria-pressed="false">Emergency</button>
      </div>
      <span class="section-switcher__hint" aria-hidden="true"> <b>→</b></span>
    </nav>

    <section class="panel immigration-card immigration-card--priority" data-home-view data-hide-after="2026-08-27T00:00:00+08:00" aria-labelledby="entry-forms-title"><div class="immigration-card__icon" aria-hidden="true">!</div><div><span class="priority-deadline">High priority · Complete 26 August</span><h2 id="entry-forms-title">2 Indonesia entry forms</h2><div class="entry-form-steps"><article><span>1</span><div><h3>All Indonesia declaration</h3><p>Required arrival, immigration, customs and health declaration. Save the QR code after submission.</p><a href="https://allindonesia.imigrasi.go.id/" target="_blank" rel="noopener noreferrer">Complete All Indonesia ↗</a></div></article><article><span>2</span><div><h3>Visa Exemption for autogate</h3><p>A separate free application for each eligible foreign traveller. All Indonesia may offer this next, but it is processed through Indonesia eVisa.</p><a href="https://evisa.imigrasi.go.id/" target="_blank" rel="noopener noreferrer">Apply for Visa Exemption ↗</a></div></article></div></div></section>

    <section class="top-essentials" id="essentials" data-home-view aria-labelledby="essentials-title">
      <div class="section-heading"><p class="eyebrow">NEXT PRIORITY</p><h2 id="essentials-title">Trip checklist</h2></div>
      <div class="panel info-disclosure info-disclosure--static"><div class="info-disclosure__header"><div><span class="eyebrow">BEFORE WE GO</span><strong>13 essentials to prepare</strong></div></div><div class="info-disclosure__content checklist">{essentials.map((item) => <label><input type="checkbox" /><span>{item}</span></label>)}</div></div>
    </section>

    <section class="up-next" data-home-view aria-labelledby="up-next-title">
      <div><p class="eyebrow">UP NEXT</p><h2 id="up-next-title">Depart Sungai Buloh</h2><p id="next-time">27 Aug · 10:00 PM MYT</p></div>
      <div class="next-icon" aria-hidden="true">→</div>
      <p class="next-detail" id="next-detail">3 cars · 9 travellers · Overnight drive</p>
    </section>

    <section class="panel today-panel" data-home-view aria-labelledby="today-title">
      <div class="section-heading"><p class="eyebrow">AT A GLANCE</p><h2 id="today-title">Today’s itinerary</h2></div>
      <div id="today-events" class="today-events"><p class="muted">&rarr; The trip begins Thursday, 27 August.</p></div>
    </section>

    <section class="notice-stack" data-home-view aria-label="Important notices">
      {notices.map((notice) => <article class={`notice notice--${notice.kind}`}><span class="notice-mark" aria-hidden="true">{notice.kind === 'confirmed' ? '✓' : '!'}</span><div><h3>{notice.label}</h3><p>{notice.text}</p></div></article>)}
    </section>

    <section class="section-block" id="itinerary" data-section-view="itinerary" aria-labelledby="itinerary-title">
      <div class="section-heading"><p class="eyebrow">THE FULL PLAN</p><h2 id="itinerary-title">Itinerary</h2></div>
      <div class="days">
        {itinerary.map((day, index) => (
          <article class="day-card" data-date={day.date}>
            <div class="day-card__header"><div><span>{day.label} · {new Date(`${day.date}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' })}</span><h3>{day.title}</h3></div></div>
            <div class="timeline">
              {day.events.map((event) => (
                <article class="event" id={event.title === 'Harbour Bay Downtown' ? 'place-harbour-bay' : event.title === 'Grand Batam Mall' ? 'place-grand-batam' : event.title === 'Ferry check-in' ? 'place-batam-centre-terminal' : undefined} data-datetime={event.datetime}>
                  <div class="event-time"><time datetime={event.datetime}>{event.time}</time><span>{event.timezone}</span></div>
                  <div class="event-copy"><div class="event-title-row"><h4>{event.title}</h4>{event.status && <span class={`badge badge--${event.status}`}>{event.status === 'tbc' ? 'TBC' : event.status}</span>}</div>{event.description && <p>{event.description}</p>}{event.meta && <small>{event.meta}</small>}</div>
                </article>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block" id="ferry" data-section-view="ferry">
      <div class="section-heading"><p class="eyebrow">CROSSING</p><h2>Ferry</h2></div>
      <div class="two-col">
        <article class="panel booking-card"><div class="card-top"><span class="badge badge--confirmed">Outbound · Confirmed</span><span>28 Aug 2026</span></div><h3>Pasir Gudang <b>→</b> Batam Centre</h3><p class="big-time">8:45 AM <small>MYT</small></p><p class="equivalent">Be at the counter by 7:15 AM MYT</p><dl><div><dt>Depart</dt><dd>Pelabuhan Pasir Gudang</dd></div><div><dt>Arrive</dt><dd>Batam Centre</dd></div></dl></article>
        <article class="panel booking-card"><div class="card-top"><span class="badge badge--confirmed">Return · Confirmed</span><span>30 Aug 2026</span></div><h3>Batam Centre <b>→</b> Pasir Gudang</h3><p class="big-time">11:20 AM <small>WIB</small></p><p class="equivalent">12:20 PM MYT · counter by 9:50 AM WIB</p><dl><div><dt>Depart</dt><dd>Batam Centre</dd></div><div><dt>Arrive</dt><dd>Pelabuhan Pasir Gudang</dd></div></dl></article>
      </div>
      <article class="panel ferry-order-card"><div class="card-top"><div><p class="eyebrow">EASYBOOK ORDER</p><h3>BRKR5HYN</h3></div><span class="badge badge--confirmed">Confirmed</span></div><dl><div><dt>Trip</dt><dd>Two way · 9 passengers</dd></div><div><dt>Operator</dt><dd>PPT Ticketing Sdn Bhd</dd></div><div><dt>Order code</dt><dd>EBMY-ON-2607229822</dd></div><div><dt>Seaport tax</dt><dd>Included</dd></div><div><dt>Luggage</dt><dd>15 kg per passenger</dd></div></dl><a class="ferry-support" href="https://wa.me/60189691080" target="_blank" rel="noopener noreferrer">Easybook WhatsApp support</a></article>
      <article class="panel info-disclosure info-disclosure--static ferry-guide"><div class="info-disclosure__header"><div><span class="eyebrow">BEFORE BOARDING</span><strong>Check-in & document reminders</strong></div></div><div class="info-disclosure__content"><ul><li>Check in at the ferry counter 90 minutes before departure.</li><li>Bring each traveller’s passport and required travel documents.</li><li>Keep the order summary available; print it if requested, as a screenshot may not be accepted.</li><li>The booking summary does not state an estimated arrival time or assigned seats.</li><li>Schedules can change—verify with the operator before travelling.</li></ul><p>The original order summary is not attached here because it contains travellers’ passport and identity details.</p></div></article>
    </section>

    <section class="section-block" id="hotel" data-section-view="hotel">
      <div class="section-heading"><p class="eyebrow">2-NIGHT STAY</p><h2>Hotel</h2></div>
      <article class="panel hotel-card">
        <div class="hotel-card__top"><div><span class="badge badge--confirmed">4 rooms confirmed · 28–30 August</span><h3>Lovina Inn Nagoya Batam</h3><p>Budget-friendly hotel in central Lubuk Baja, Batam.</p></div><span class="hotel-rating">2-star</span></div>
        <address>Komplek Sri Usaha, Blk. H No. 8, Lubuk Baja Kota, Kota Batam, Kepulauan Riau 29444, Indonesia</address>
        <div class="hotel-details"><div class="hotel-details__header">Nearby places & amenities</div><div class="hotel-details__content">
          <div class="hotel-location-grid">
            <div><span>Walkable</span><strong>Nagoya Citywalk</strong><small>≈ 240 m · about 3–5 min</small></div>
            <div><span>Walkable</span><strong>Nagoya Hill Mall</strong><small>≈ 300–500 m · about 4–7 min</small></div>
            <div><span>Day 1 itinerary</span><strong>Harbour Bay</strong><small>≈ 1.7–2.5 km · about 8 min by car</small><a class="hotel-itinerary-link" href="#place-harbour-bay">See in itinerary →</a></div>
            <div><span>Day 2 itinerary</span><strong>Grand Batam Mall</strong><small>≈ 1.5–1.9 km · short drive</small><a class="hotel-itinerary-link" href="#place-grand-batam">See in itinerary →</a></div>
            <div><span>Day 3 itinerary</span><strong>Batam Centre terminal</strong><small>≈ 5.5–8 km · about 10–16 min by car</small><a class="hotel-itinerary-link" href="#place-batam-centre-terminal">See in itinerary →</a></div>
          </div>
          <ul class="amenity-list" aria-label="Hotel amenities"><li>Free Wi-Fi</li><li>Basic breakfast</li><li>24-hour front desk</li><li>Air conditioning</li><li>Lift access</li><li>Halal dining</li><li>Free parking</li></ul>
        </div></div>
        <div class="hotel-details booking-confirmation-details"><div class="hotel-details__header">Booking & check-in details</div><div class="hotel-details__content"><dl class="hotel-booking-facts"><div><dt>Check-in</dt><dd>28 Aug · from 3:00 PM</dd></div><div><dt>Check-out</dt><dd>30 Aug · by 12:00 PM</dd></div><div><dt>Confirmations</dt><dd>5440.336.138 · 6085.884.190</dd></div><div><dt>Meal plan</dt><dd>No meals included</dd></div></dl><p class="hotel-arrival-note">Arrive before 6:00 PM. Contact the hotel in advance if the group will be later, and present the confirmations with valid ID at check-in.</p></div></div>
        <div class="hotel-actions"><a href="tel:+62778421789">Call hotel</a><a class="hotel-action--secondary" href="https://www.lovinainn.com/" target="_blank" rel="noopener noreferrer">Official website</a></div>
      </article>
      <div class="panel info-disclosure info-disclosure--static"><div class="info-disclosure__header"><div><span class="eyebrow">ROOM ALLOCATION</span><strong>4 rooms · 9 travellers</strong></div></div><div class="info-disclosure__content compact-grid">{rooms.map(([room, type, guests]) => <article class="compact-card"><span>{room}</span><h3>{type}</h3><p>{guests}</p></article>)}</div></div>
    </section>

    <section class="section-block" id="crew" data-section-view="crew">
      <div class="section-heading"><p class="eyebrow">9 TRAVELLERS · 3 CARS</p><h2>Crew</h2></div>
      <div class="panel info-disclosure info-disclosure--static"><div class="info-disclosure__header"><div><span class="eyebrow">CAR ALLOCATION</span><strong>3-car arrangement</strong></div></div><div class="info-disclosure__content compact-grid car-grid">{cars.map(([car, people, pic, phone]) => <article class="compact-card car-card"><h3>{car}</h3><p>{people}</p><a class="car-pic" href={`tel:${phone}`}><span>PIC · {pic}</span><b>{phone}</b></a></article>)}</div></div>
      <!-- <article class="notice notice--info"><span class="notice-mark">i</span><div><h3>Travelling with a child</h3><p>Nayla is an infant. Confirm infant ferry rules, pricing, insurance and medical arrangements separately.</p></div></article> -->
    </section>

    <section class="section-block" id="supir" data-section-view="supir">
      <div class="section-heading"><p class="eyebrow">LOCAL TRANSPORT</p><h2>Supir</h2></div>
      <article class="panel supir-profile"><div class="supir-avatar" aria-hidden="true">CR</div><div><span class="badge badge--confirmed">Driver confirmed</span><h3>Christina Rahmawati</h3><p>Local driver · Batam · +62 852-3266-1117</p></div><a href="https://www.tiktok.com/@dlapandlapan.tour" target="_blank" rel="noopener noreferrer">TikTok · @dlapandlapan.tour</a></article>
      <article class="panel feature-card transport"><div><span class="badge badge--confirmed">2 cars · Booked for 2 days</span><h3>28–29 August · 9:00 AM–10:00 PM</h3><div class="transport-rate"><div><span>Daily rate · 2 cars</span><strong>IDR 1,500,000</strong><small>≈ RM343.27</small></div><div><span>2-day total</span><strong>IDR 3,000,000</strong><small>≈ RM686.54</small></div></div><p class="price">IDR 375,000 <span>≈ RM85.82</span><small>per paying adult · 8 adults · Nayla excluded</small></p><p>Pickup at Batam Centre ferry terminal is confirmed. Car models are still pending; registration plates are not required for this portal.</p><p class="conversion-note">MYR estimates use the Wise mid-market rate checked 25 Aug 2026: RM1 = IDR 4,369.71.</p></div><div class="actions"><a href="https://wa.me/6285232661117" target="_blank" rel="noopener">WhatsApp</a><a href="tel:+6285232661117">Call</a></div></article>
    </section>

    <section class="section-block" id="esim" data-section-view="esim">
      <div class="section-heading"><p class="eyebrow">CONNECTIVITY</p><h2>eSIM</h2></div>
      <article class="panel readiness esim-summary"><div><span class="ready-check">✓</span><div><span class="badge badge--confirmed">Order ready</span><h3>Trip.com eSIM order</h3><p>Aniq will manage and distribute the travellers’ eSIMs from this shared order.</p></div></div><a class="esim-order-link" href={esimOrderUrl} target="_blank" rel="noopener noreferrer">Manage eSIMs on Trip.com ↗</a></article>
      <!-- <div class="esim-grid" aria-label="Traveller connectivity status">
        <article><span class="badge badge--confirmed">Own roaming</span><strong>Badiuz</strong></article>
        <article><span class="badge badge--tbc">Not required</span><strong>Nayla</strong><small>1 year old · no phone</small></article>
      </div> -->
      <article class="panel info-disclosure info-disclosure--static esim-guide"><div class="info-disclosure__header"><div><span class="eyebrow">SETUP GUIDE</span><strong>Before eSIM installation</strong></div></div><div class="info-disclosure__content"><ol><li>Use a stable internet connection.</li><li>Install on the phone that will use it—the eSIM cannot be transferred after installation.</li><li>Activate after arriving at the destination.</li><li>Turn on the eSIM line and data roaming.</li></ol></div></article>
    </section>

    <section class="section-block" id="insurance" data-section-view="insurance">
      <div class="section-heading"><p class="eyebrow">COVERAGE</p><h2>Insurance</h2></div>
      <article class="panel insurance-summary">
        <div class="card-top"><span class="badge badge--confirmed">6 travellers covered</span><span>28–30 Aug 2026</span></div>
        <h3>Zurich Travel Takaful</h3><p>International · Basic Plan · Southeast Asia · Group return cover</p>
        <div class="insurance-actions"><a href="/trip-files/zt-2026-6p-a8f31c7d92e64b0f.pdf" target="_blank" rel="noopener">Open protected policy PDF</a><a class="insurance-action--secondary" href="tel:1300888622">Call Zurich customer care</a></div>
        <details class="insurance-details"><summary>Policy details, covered names & benefits <span>View</span></summary><div class="insurance-details__content"><dl><div><dt>Certificate</dt><dd>PZTIMYGT038514</dd></div><div><dt>Travel Assist</dt><dd>Included</dd></div><div><dt>Total contribution</dt><dd>RM140.29</dd></div></dl><div class="covered-people"><span>People covered</span><ul><li>Muhammad Amrun Aniq bin Mohamed Saidi</li><li>Azilah binti Abd Aziz</li><li>Dedi bin Jalinas</li><li>Khairrin Naim bin Redzuan</li><li>Intan Nurshahira binti Razaly</li><li>Muhammad Faisal bin Hasan</li></ul></div><div class="benefit-grid" aria-label="Key insurance benefits"><article><span>Overseas medical</span><strong>Up to RM100,000</strong></article><article><span>Medical evacuation</span><strong>Unlimited</strong></article><article><span>Personal accident</span><strong>RM150,000</strong></article><article><span>Personal liability</span><strong>RM750,000</strong></article><article><span>Travel cancellation</span><strong>Up to RM20,000</strong></article><article><span>Baggage & effects</span><strong>Up to RM3,000</strong></article></div><p class="policy-note">The attached policy remains password-protected; its password is not displayed or stored on this page. Coverage remains subject to the certificate terms, conditions and exclusions. Zurich’s listed number is customer care, not a confirmed overseas emergency hotline.</p></div></details>
      </article>
      <article class="panel insurance-summary takaful-summary">
        <div class="card-top"><span class="badge badge--confirmed">3 travellers covered</span><span>28–30 Aug 2026</span></div>
        <h3>Takaful Malaysia myTRAVEL PA</h3><p>Family plan · Bronze · Region 1 · Overseas coverage</p>
        <div class="insurance-actions"><a href="tel:+60376283905">Call 24-hour assistance</a><a class="insurance-action--secondary" href="tel:130088252385">Call customer care</a></div>
        <details class="insurance-details"><summary>Policy details, covered names & benefits <span>View</span></summary><div class="insurance-details__content"><dl><div><dt>Certificate</dt><dd>TPAF00026645</dd></div><div><dt>Total contribution</dt><dd>RM55.00</dd></div><div><dt>Travel assistance</dt><dd>Included</dd></div></dl><div class="covered-people"><span>People covered</span><ul><li>Badiuz Zaman bin Badrul Idza</li><li>Nur Nasuha binti Mazalan</li><li>Nur Nayla Bahiyyah binti Badiuz Zaman</li></ul></div><div class="benefit-grid" aria-label="Key Takaful Malaysia benefits"><article><span>Personal accident · family</span><strong>Up to RM300,000</strong></article><article><span>Medical expenses · family</span><strong>Up to RM300,000</strong></article><article><span>Medical evacuation</span><strong>Unlimited</strong></article><article><span>Baggage & effects · family</span><strong>Up to RM7,500</strong></article><article><span>Personal liability · family</span><strong>Up to RM750,000</strong></article><article><span>Travel cancellation · family</span><strong>Up to RM15,000</strong></article></div><p class="policy-note">The original certificate is not linked here because it contains identity numbers, birth dates and a home address. Coverage remains subject to the certificate wording, terms and exclusions.</p></div></details>
      </article>
    </section>

    <section class="section-block" id="photos" data-section-view="photos">
      <div class="section-heading"><p class="eyebrow">SHARED MEMORIES</p><h2>Trip photos</h2></div>
      <article class="panel album-card"><div class="album-card__visual" aria-hidden="true"><span>BATAM</span><strong>2026</strong><div><i></i><i></i><i></i></div></div><div class="album-card__copy"><span class="badge badge--confirmed">Public album live</span><h3>Batam 2026 Shared Album</h3><p>View the group’s latest photos and videos in any browser—useful for Android users and anyone without the Apple Photos invitation.</p><a href={sharedAlbumUrl} target="_blank" rel="noopener noreferrer">View shared album ↗</a><small>Invited Apple users can contribute through Shared Albums. The public web link is primarily for viewing.</small></div></article>
    </section>

    <section class="section-block" id="payments" data-section-view="payments">
      <div class="section-heading"><p class="eyebrow">MONEY NOTES</p><h2>Payments</h2></div>
      <section class="panel fx-converter" id="currency" aria-labelledby="fx-title" data-rate="4369.71">
        <div class="fx-heading"><div><p class="eyebrow">WISE RATE SNAPSHOT</p><h2 id="fx-title">Quick currency check</h2></div><span>Checked 25 Aug 2026</span></div>
        <div class="fx-fields">
          <label><span>You have</span><div><b id="fx-from-symbol">RM</b><input id="fx-amount" type="number" min="0" step="any" inputmode="decimal" value="100" aria-describedby="fx-rate-note" /><strong id="fx-from-code">MYR</strong></div></label>
          <button class="fx-swap" id="fx-swap" type="button" aria-label="Swap MYR and IDR">⇄</button>
          <div class="fx-result" aria-live="polite"><span>You get approximately</span><div><b id="fx-to-symbol">Rp</b><output id="fx-output" for="fx-amount">436,971</output><strong id="fx-to-code">IDR</strong></div></div>
        </div>
        <div class="fx-footer"><details><summary>Rate details</summary><p id="fx-rate-note">Wise mid-market reference on 25 Aug 2026: RM1 = Rp4,369.71. Rates change; fees and the final card or transfer amount may differ.</p></details><a href="https://wise.com/my/currency-converter/myr-to-idr-rate" target="_blank" rel="noopener noreferrer">Live Wise rate ↗</a></div>
      </section>
      <article class="panel info-disclosure info-disclosure--static currency-card"><div class="info-disclosure__header"><div><span class="eyebrow">PAYMENT NOTES</span><strong>Cash, Wise & QRIS</strong></div></div><div class="info-disclosure__content"><div class="currency"><div><span>Malaysia</span><strong>MYR</strong><p>Terminal fees and Malaysia-side expenses</p></div><div><span>Batam</span><strong>IDR</strong><p>Terminal fees, local and cash-only expenses</p></div></div><small>Wise / QRIS may work where supported. Carry physical cash as backup.</small></div></article>
      <article class="panel bank-card"><div class="card-top"><div><p class="eyebrow">SUPIR PAYMENT ACCOUNT</p><h3>BRI · Christina Rahmawati</h3></div><span class="badge badge--confirmed">Confirmed</span></div><code>0621 0108 8401 509</code><button type="button" data-copy-account="062101088401509">Copy account number</button></article>
