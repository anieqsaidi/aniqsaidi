        day.classList.toggle('is-open', active);
        day.querySelector(':scope > .ui-disclosure__trigger')?.setAttribute('aria-expanded', String(active));
        const timeline = day.querySelector(':scope > .timeline');
        if (timeline instanceof HTMLElement) timeline.hidden = !active;
      });
    };
    const openCurrentItineraryDay = () => {
      const days = [...document.querySelectorAll('.day-card[data-date]')];
      if (!days.length) return;
      const parts = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
      const value = (type) => parts.find((part) => part.type === type)?.value || '';
      const today = `${value('year')}-${value('month')}-${value('day')}`;
      const exact = days.find((day) => day.getAttribute('data-date') === today);
      const nearest = today < (days[0].getAttribute('data-date') || '') ? days[0] : [...days].reverse().find((day) => (day.getAttribute('data-date') || '') <= today) || days.at(-1);
      openItineraryDay(exact || nearest);
    };
    let activeView = 'home';
    const setView = (requestedView, { updateHistory = true, toggle = false } = {}) => {
      const requested = validViews.has(requestedView) ? requestedView : 'home';
      const view = toggle && requested === activeView && requested !== 'home' ? 'home' : requested;
      activeView = view;
      if (view === 'itinerary') openCurrentItineraryDay();
      viewPanels.forEach((panel) => {
        const visible = view === 'home' ? panel.hasAttribute('data-home-view') : panel.dataset.sectionView === view;
        panel.hidden = !visible || panel.dataset.expired === 'true';
      });
      viewButtons.forEach((button) => {
        const active = button.dataset.view === view;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      const activeButton = viewButtons.find((button) => button.dataset.view === view);
      window.requestAnimationFrame(() => revealViewButton(activeButton, updateHistory ? 'smooth' : 'auto'));
      if (updateHistory) {
        const url = view === 'home' ? `${location.pathname}${location.search}` : `#${view}`;
        history.pushState({ view }, '', url);
      }
    };
    viewButtons.forEach((button) => button.addEventListener('click', () => {
      setView(button.dataset.view || 'home', { toggle: true });
      if (tripContent) tripContent.scrollTop = 0;
    }));
    document.querySelector('[data-open-profile]')?.addEventListener('click', () => {
      setView('profile');
      if (tripContent) tripContent.scrollTop = 0;
    });
    const initialView = localStorage.getItem('batam.session.v1') ? 'home' : sectionForHash(location.hash);
    setView(initialView, { updateHistory: false });
    window.addEventListener('batam-profile-ready', () => setView(activeView, { updateHistory: false }));
    window.addEventListener('batam-open-home', () => { setView('home', { updateHistory: false }); if (tripContent) tripContent.scrollTop = 0; });
    window.addEventListener('popstate', () => setView(sectionForHash(location.hash), { updateHistory: false }));
    document.querySelectorAll('.hotel-itinerary-link').forEach((link) => link.addEventListener('click', (event) => {
      const targetId = link.getAttribute('href')?.slice(1);
      const target = targetId ? document.getElementById(targetId) : null;
      const day = target?.closest('.day-card');
      if (!target || !day) return;
      event.preventDefault();
      setView('itinerary', { updateHistory: false });
      openItineraryDay(day);
      history.pushState({ view: 'itinerary' }, '', `#${targetId}`);
      requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth', block: 'center' }));
    }));
  </script>
</TripLayout>
