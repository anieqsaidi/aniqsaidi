  <script define:vars={{ itinerary, allEvents }}>
    const fxCard = document.querySelector('.fx-converter');
    const fxInput = document.getElementById('fx-amount');
    const fxOutput = document.getElementById('fx-output');
    const fxSwap = document.getElementById('fx-swap');
    const fxRate = Number(fxCard?.getAttribute('data-rate')) || 4369.71;
    let fxDirection = 'MYR_IDR';
    const formatFx = (value, currency) => new Intl.NumberFormat('en-MY', { maximumFractionDigits: currency === 'MYR' ? 2 : 0 }).format(value);
    const updateFx = () => {
      const amount = Math.max(0, Number(fxInput?.value) || 0);
      const converted = fxDirection === 'MYR_IDR' ? amount * fxRate : amount / fxRate;
      if (fxOutput) fxOutput.textContent = formatFx(converted, fxDirection === 'MYR_IDR' ? 'IDR' : 'MYR');
    };
    fxInput?.addEventListener('input', updateFx);
    fxSwap?.addEventListener('click', () => {
      const converted = Number((fxOutput?.textContent || '0').replaceAll(',', '')) || 0;
      fxDirection = fxDirection === 'MYR_IDR' ? 'IDR_MYR' : 'MYR_IDR';
      if (fxInput) fxInput.value = String(converted);
      document.getElementById('fx-from-symbol').textContent = fxDirection === 'MYR_IDR' ? 'RM' : 'Rp';
      document.getElementById('fx-from-code').textContent = fxDirection === 'MYR_IDR' ? 'MYR' : 'IDR';
      document.getElementById('fx-to-symbol').textContent = fxDirection === 'MYR_IDR' ? 'Rp' : 'RM';
      document.getElementById('fx-to-code').textContent = fxDirection === 'MYR_IDR' ? 'IDR' : 'MYR';
      fxSwap.setAttribute('aria-label', fxDirection === 'MYR_IDR' ? 'Swap MYR and IDR' : 'Swap IDR and MYR');
      updateFx();
    });

    const formatDateTime = (date, zone) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', hour12: true, timeZone: zone }).format(date).replace(',', ' ·');
    const now = new Date();
    const tripStatus = document.getElementById('trip-status');
    const tripStages = [
      ['2026-08-27T22:00:00+08:00', 'Awaiting departure · 27 Aug at approximately 10:00 PM MYT'],
      ['2026-08-28T04:00:00+08:00', 'En route to Pasir Gudang'],
      ['2026-08-28T08:45:00+08:00', 'At Pasir Gudang · Preparing for ferry departure'],
      ['2026-08-28T08:45:00+07:00', 'Crossing to Batam Centre'],
      ['2026-08-30T11:20:00+07:00', 'In Batam · Following the live itinerary'],
      ['2026-08-30T13:20:00+08:00', 'Returning by ferry to Pasir Gudang'],
      ['2026-08-30T19:20:00+08:00', 'Arrived at Pasir Gudang · Driving home'],
      ['9999-12-31T23:59:59+00:00', 'Trip complete · Welcome home'],
    ];
    const updateTripStatus = () => {
      const currentTime = Date.now();
      const stage = tripStages.find(([until]) => currentTime < new Date(until).getTime());
      if (!tripStatus || !stage) return;
      if (stage[1].startsWith('In Batam')) {
        const nextBatamEvent = allEvents.find((event) => new Date(event.datetime).getTime() > currentTime);
        tripStatus.textContent = nextBatamEvent ? `In Batam · Next: ${nextBatamEvent.title}` : stage[1];
      } else tripStatus.textContent = stage[1];
    };
    updateTripStatus();
    window.setInterval(updateTripStatus, 60000);
    document.querySelectorAll('[data-hide-after]').forEach((element) => {
      const hideAfter = new Date(element.getAttribute('data-hide-after'));
      if (!Number.isNaN(hideAfter.getTime()) && now >= hideAfter) {
        element.dataset.expired = 'true';
        element.hidden = true;
      }
    });
    const entryReminder = document.getElementById('entry-reminder');
    const entryCountdown = document.getElementById('entry-countdown');
    const entryDeadline = new Date(entryReminder?.getAttribute('data-hide-after') || '2026-08-27T00:00:00+08:00');
    const updateEntryCountdown = () => {
      const remaining = Math.max(0, entryDeadline.getTime() - Date.now());
      const totalMinutes = Math.floor(remaining / 60000);
      const days = Math.floor(totalMinutes / 1440);
      const hours = Math.floor((totalMinutes % 1440) / 60);
      const minutes = totalMinutes % 60;
      if (entryCountdown) entryCountdown.textContent = days > 0 ? `${days}d ${hours}h ${minutes}m` : `${hours}h ${minutes}m`;
      if (remaining === 0 && entryReminder?.open) entryReminder.close();
    };
    if (entryReminder && now < entryDeadline) {
      updateEntryCountdown();
      window.setInterval(updateEntryCountdown, 60000);
      window.requestAnimationFrame(() => entryReminder.showModal());
    }
    entryReminder?.querySelector('.entry-reminder__close')?.addEventListener('click', () => entryReminder.close());
    entryReminder?.addEventListener('click', (event) => { if (event.target === entryReminder) entryReminder.close(); });
    const next = allEvents.find((event) => new Date(event.datetime) > now);
    if (next) {
      document.getElementById('up-next-title').textContent = next.title;
      document.getElementById('next-time').textContent = `${formatDateTime(new Date(next.datetime), next.timezone === 'MYT' ? 'Asia/Kuala_Lumpur' : 'Asia/Jakarta')} ${next.timezone}`;
      document.getElementById('next-detail').textContent = next.description || 'See the full itinerary below.';
    } else {
      document.getElementById('up-next-title').textContent = 'Trip complete';
      document.getElementById('next-time').textContent = 'Thanks for the memories';
      document.getElementById('next-detail').textContent = 'Batam 2026 · 3 days, 2 nights';
    }

    const dayKey = new Intl.DateTimeFormat('en-CA', { timeZone: now < new Date('2026-08-28T00:00:00+07:00') ? 'Asia/Kuala_Lumpur' : 'Asia/Jakarta', year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
    const today = itinerary.find((day) => day.date === dayKey);
    const todayEl = document.getElementById('today-events');
    if (today && todayEl) {
      todayEl.innerHTML = today.events.map((event) => `<div><time>${event.time} <b>${event.timezone}</b></time><span>${event.title}</span></div>`).join('');
    }

    document.querySelectorAll('.checklist input').forEach((input) => {
      input.addEventListener('change', () => input.closest('label')?.classList.toggle('checked', input.checked));
    });
    document.querySelectorAll('[data-copy-account]').forEach((button) => button.addEventListener('click', async () => {
      const value = button.getAttribute('data-copy-account');
      if (!value) return;
      await navigator.clipboard.writeText(value);
      const original = button.textContent;
      button.textContent = 'Copied';
      window.setTimeout(() => { button.textContent = original; }, 1600);
    }));

    const viewButtons = [...document.querySelectorAll('[data-view]')];
    const viewPanels = [...new Set([...document.querySelectorAll('[data-home-view], [data-section-view]')])];
    const validViews = new Set(viewButtons.map((button) => button.dataset.view));
    const sectionForHash = (hash) => {
      const id = hash.replace(/^#/, '');
      if (validViews.has(id)) return id;
      return document.getElementById(id)?.closest('[data-section-view]')?.dataset.sectionView || 'home';
    };
    let activeView = 'home';
    const setView = (requestedView, { updateHistory = true, toggle = false } = {}) => {
      const requested = validViews.has(requestedView) ? requestedView : 'home';
      const view = toggle && requested === activeView && requested !== 'home' ? 'home' : requested;
      activeView = view;
      viewPanels.forEach((panel) => {
        const visible = view === 'home' ? panel.hasAttribute('data-home-view') : panel.dataset.sectionView === view;
        panel.hidden = !visible || panel.dataset.expired === 'true';
      });
      viewButtons.forEach((button) => {
        const active = button.dataset.view === view;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      if (updateHistory) {
        const url = view === 'home' ? `${location.pathname}${location.search}` : `#${view}`;
        history.pushState({ view }, '', url);
      }
    };
    viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.view || 'home', { toggle: true })));
    const initialView = sectionForHash(location.hash);
    setView(initialView, { updateHistory: false });
    window.addEventListener('popstate', () => setView(sectionForHash(location.hash), { updateHistory: false }));
    document.querySelectorAll('.hotel-itinerary-link').forEach((link) => link.addEventListener('click', (event) => {
      const targetId = link.getAttribute('href')?.slice(1);
      const target = targetId ? document.getElementById(targetId) : null;
      const day = target?.closest('.day-card');
      if (!target || !day) return;
      event.preventDefault();
      setView('itinerary', { updateHistory: false });
      history.pushState({ view: 'itinerary' }, '', `#${targetId}`);
      requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth', block: 'center' }));
    }));
  </script>
</TripLayout>
