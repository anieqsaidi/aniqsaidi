---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import AnimatedText from '../components/AnimatedText.astro';
import { leadership } from '../data/cv';

const featuredLeadership = leadership.slice(0, 5);
const moreLeadership = leadership.slice(5);
---

<Layout title="LEADERSHIP" description="Leadership experience of Aniq Saidi.">
  <Frame title="LEADERSHIP">
    <div data-fit-group data-mobile-min="1" data-desktop-count="5">
    <div class="credential-list" data-fit-visible>
      {featuredLeadership.map(([title, detail], index) => (
        <article class="credential credential--stacked" data-fit-item data-order={index}>
          <div>
            <h2>{title}</h2>
            <p>
              {index === 0
                ? <AnimatedText text={detail} word="advocated" effect="wave" delay={-2.6} />
                : index === 1
                  ? <AnimatedText text={detail} word="Malaysia's" effect="scan" delay={-4.2} />
                  : detail}
            </p>
          </div>
        </article>
      ))}
    </div>
    <details class="career-details" data-fit-details>
      <summary>
        <span class="details-closed">[+] READ MORE LEADERSHIP</span>
        <span class="details-open">[-] SHOW FEWER LEADERSHIP</span>
      </summary>
      <div class="credential-list credential-list--continued" data-fit-overflow>
        {moreLeadership.map(([title, detail], index) => (
          <article class="credential credential--stacked" data-fit-item data-order={featuredLeadership.length + index}>
            <div>
              <h2>
                {index === 0
                  ? <AnimatedText text={title} word="Safety" effect="pulse" delay={-4.7} />
                  : index === 1
                    ? <AnimatedText text={title} word="Secretary" effect="jitter" delay={-2.5} />
                    : <AnimatedText text={title} word="President" effect="scan" delay={-5.4} />}
              </h2>
              <p>{detail}</p>
            </div>
          </article>
        ))}
      </div>
    </details>
    </div>
  </Frame>
</Layout>
