---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import AnimatedText from '../components/AnimatedText.astro';
import RecordHighlights from '../components/RecordHighlights.astro';
import ContentSort from '../components/ContentSort.astro';
import { leadership } from '../data/cv';
import { latestFirst } from '../data/recordOrder';

const sortedLeadership = latestFirst(leadership.map(([title, detail], index) => ({
  title, detail, description: detail, period: detail, index, sortOrder: index,
})));

const highlightedIndexes = new Set([0, 1, 4]);
const highlightRecords = leadership.map(([title, detail], index) => ({
  index,
  signal: index === 0 ? 'CAMPUS // PRESIDENT' : index === 1 ? 'NATIONAL // COUNCIL' : 'GLOBAL // SERVICE',
  title,
  description: detail,
  featured: highlightedIndexes.has(index),
}));
---

<Layout title="LEADERSHIP" description="Leadership experience of Aniq Saidi.">
  <Frame title="LEADERSHIP">
    <RecordHighlights page="leadership" records={highlightRecords} />
    <ContentSort scope="leadership" />
    <div class="credential-list" data-cms-collection="leadership.leadership" data-sort-scope="leadership" data-sort-container>
      {sortedLeadership.map(({ title, detail, index }) => (
        <article class="credential credential--stacked" data-sort-item data-sort-date={detail} data-sort-title={title}>
          <div>
            <h2 data-cms-field={`leadership.${index}.title`}>
              {index === 5
                ? <AnimatedText text={title} word="Safety" effect="pulse" delay={-4.7} />
                : index === 6
                  ? <AnimatedText text={title} word="Secretary" effect="jitter" delay={-2.5} />
                  : index === 7
                    ? <AnimatedText text={title} word="President" effect="scan" delay={-5.4} />
                    : title}
            </h2>
            <p data-cms-field={`leadership.${index}.detail`}>
              {index === 0
                ? <AnimatedText text={detail} word="advocated" effect="wave" delay={-2.6} />
                : index === 1
                  ? <AnimatedText text={detail} word="Malaysia's" effect="scan" delay={-4.2} />
                  : detail}
            </p>
          </div>
        </article>
      ))}
    </div>
  </Frame>
</Layout>
