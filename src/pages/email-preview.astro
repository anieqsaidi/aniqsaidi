---
import { renderCvDeliveryEmail } from '../../functions/cv-delivery-template.mjs';

const email = renderCvDeliveryEmail({
  recipientEmail: 'recruiter@example.com',
  cvVersion: 'CURRENT',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>CV Email Preview — Aniq Saidi</title>
  </head>
  <body>
    <header class="preview-bar">
      <div>
        <strong>CV email preview</strong>
        <span>Subject: {email.subject}</span>
      </div>
      <div class="preview-actions" aria-label="Preview width">
        <button type="button" data-width="desktop" aria-pressed="true">Desktop</button>
        <button type="button" data-width="mobile" aria-pressed="false">Mobile</button>
      </div>
    </header>
    <main>
      <iframe
        id="email-frame"
        title="Rendered CV delivery email"
        srcdoc={email.html}
        sandbox="allow-popups allow-popups-to-escape-sandbox"
      ></iframe>
    </main>

    <script>
      const frame = document.querySelector<HTMLIFrameElement>('#email-frame');
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-width]');
      buttons.forEach((button) => button.addEventListener('click', () => {
        frame?.classList.toggle('is-mobile', button.dataset.width === 'mobile');
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      }));
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; background: #171717; color: #f5f5f5; }
  .preview-bar {
    position: sticky; top: 0; z-index: 1; display: flex; align-items: center;
    justify-content: space-between; gap: 20px; padding: 14px 20px;
    border-bottom: 1px solid #3a3a3a; background: rgba(23, 23, 23, .96);
  }
  .preview-bar div:first-child { display: grid; gap: 3px; }
  .preview-bar strong { font-size: 14px; }
  .preview-bar span { color: #aaa; font-size: 12px; }
  .preview-actions { display: flex; gap: 6px; }
  button {
    border: 1px solid #555; border-radius: 6px; padding: 7px 11px;
    background: transparent; color: #ddd; cursor: pointer;
  }
  button[aria-pressed='true'] { border-color: #fff; background: #fff; color: #111; }
  main { display: flex; justify-content: center; padding: 28px 12px 48px; overflow: auto; }
  iframe {
    width: min(100%, 760px); height: 760px; border: 1px solid #444;
    border-radius: 8px; background: #f3f3f3; transition: width .2s ease;
  }
  iframe.is-mobile { width: 390px; }
  @media (max-width: 560px) {
    .preview-bar { align-items: flex-start; flex-direction: column; }
    iframe, iframe.is-mobile { width: 100%; }
  }
</style>
