---
import '../styles/car.css';
import '../styles/car-refresh.css';
interface Props { title: string; page: string }
const { title, page } = Astro.props;
const nav = [
  { href: '/car/', label: 'Home', icon: '⌂', key: 'home' },
  { href: '/car/maintenance/', label: 'Maintenance', icon: '⚙', key: 'maintenance' },
  { href: '/car/loan/', label: 'Loan', icon: '◈', key: 'loan' },
  { href: '/car/vehicle/', label: 'My Car', icon: '▰', key: 'vehicle' },
];
---
<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} · My Car</title>
  </head>
  <body data-car-page={page}>
    <header class="car-header"><div class="car-header-inner"><a class="car-brand" href="/car/" aria-label="My Car home"><span class="car-mark">M</span><span>MY CAR<small>OWNERSHIP DASHBOARD</small></span></a><div class="car-header-actions"><label class="sr-only" for="car-switch">Current vehicle</label><select id="car-switch" hidden></select><button id="car-sign-out" type="button" hidden>Sign out</button></div></div></header>
    <div class="car-shell"><aside class="car-sidebar"><p class="car-nav-label">YOUR GARAGE</p><nav aria-label="Car navigation">{nav.map((item) => <a href={item.href} aria-current={page === item.key ? 'page' : undefined}><span aria-hidden="true">{item.icon}</span>{item.label}</a>)}<a href="/car/history/" aria-current={page === 'history' ? 'page' : undefined}><span aria-hidden="true">≡</span>History</a><a href="/car/expenses/" aria-current={page === 'expenses' ? 'page' : undefined}><span aria-hidden="true">↗</span>Expenses</a></nav><div class="car-sidebar-note">MADE FOR THE MILES AHEAD</div></aside><main class="car-main"><section id="car-auth" class="car-auth card" aria-live="polite"><div class="car-auth-art" aria-hidden="true"><span class="car-auth-art__label">PRIVATE GARAGE / MALAYSIA</span><strong>Every mile<br/>has a story<span>.</span></strong><div class="car-auth-art__road"><i></i><i></i><i></i></div><span class="car-auth-art__footer">YOUR OWNERSHIP COMPANION&nbsp; ↗</span></div><div class="car-auth-body"><div class="car-auth-icon">M</div><p class="eyebrow">WELCOME BACK</p><h1>Your car,<br/>all in one place.</h1><p id="car-auth-message">Checking your sign-in…</p><button id="car-sign-in" class="button primary" type="button" hidden>Continue with Google <span aria-hidden="true">→</span></button><small>Private to your authorized account.</small></div></section><div id="car-app" hidden><div class="page-head"><p class="eyebrow">MY CAR <span>/</span> {title.toUpperCase()}</p><h1>{title}<span class="page-head-period">.</span></h1><p id="car-page-intro"><slot name="intro" /></p></div><p id="car-status" class="car-status" role="status" aria-live="polite" hidden></p><div id="car-page-content"><slot /></div></div></main></div>
    <nav class="car-bottom-nav" aria-label="Car navigation">{nav.map((item) => <a href={item.href} aria-current={page === item.key ? 'page' : undefined}><span aria-hidden="true">{item.icon}</span><span>{item.label}</span></a>)}</nav>
    <script>import { initializeCar } from '../car/ui'; initializeCar();</script>
  </body>
</html>
