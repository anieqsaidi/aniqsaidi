---
import '../styles/admin.css';
import { SITE_TITLE } from '../consts';

interface Props { title?: string; description?: string }
const { title = 'Administration', description = `Private administration for ${SITE_TITLE}.` } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const area = path.endsWith('/dashboard') ? 'Overview' : path.endsWith('/media') ? 'Media library' : path.endsWith('/editorial') ? 'SEO & quality' : 'Content editor';
const navigation = [
  { label: 'Overview', href: '/admin/dashboard/', icon: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z', group: 'Workspace' },
  { label: 'Recruiter inbox', href: '/admin/dashboard/#recruiter-title', icon: 'M4 4h16v16H4zM4 13h4l2 3h4l2-3h4', group: 'Workspace' },
  { label: 'Analytics', href: '/admin/dashboard/#traffic-title', icon: 'M4 20V10m8 10V4m8 16v-7', group: 'Workspace' },
  { label: 'Site health', href: '/admin/dashboard/#site-health-title', icon: 'M3 12h4l3-8 4 16 3-8h4', group: 'Workspace' },
  { label: 'Content', href: '/admin/', icon: 'M14 3H5v18h14V8zM14 3v5h5M8 12h8M8 16h5', group: 'Publishing' },
  { label: 'Media library', href: '/admin/media/', icon: 'M3 3h18v18H3zM3 16l6-6 5 5 3-3 4 4M15 7h.01', group: 'Publishing' },
  { label: 'SEO & quality', href: '/admin/editorial/', icon: 'M21 21l-6-6M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0', group: 'Publishing' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#f5f6f2" />
    <link rel="icon" type="image/png" sizes="1254x1254" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} · Aniq Saidi Admin</title>
    <script is:inline>
      try { localStorage.setItem('aniq.analytics.exclude', 'true'); } catch {}
    </script>
  </head>
  <body class="admin-page">
    <a class="skip-link" href="#admin-main-content">Skip to content</a>
    <div class="admin-layout">
      <aside class="workspace-sidebar" aria-label="Administration">
        <a class="workspace-brand" href="/admin/dashboard/" aria-label="Aniq Saidi administration overview">
          <span class="workspace-monogram" aria-hidden="true">as.</span>
          <span><strong>Aniq Saidi</strong><small>Administration</small></span>
        </a>
        <nav class="workspace-nav" aria-label="Admin navigation">
          {['Workspace', 'Publishing'].map((group) => <div class="workspace-nav-group">
            <p>{group}</p>
            {navigation.filter((item) => item.group === group).map((item) => <a href={item.href} data-workspace-link aria-current={!item.href.includes('#') && item.href.replace(/\/$/, '') === path ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
              <span>{item.label}</span>
            </a>)}
          </div>)}
        </nav>
        <div class="workspace-sidebar-bottom">
          <a class="workspace-trip" href="/batam/admin/"><span class="workspace-trip-icon" aria-hidden="true">B26</span><span><strong>Batam portal</strong><small>Trip administration</small></span><span aria-hidden="true">↗</span></a>
          <div class="workspace-private"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 10h14v11H5zM8 10V6a4 4 0 0 1 8 0v4" /></svg><span>Private workspace</span></div>
        </div>
      </aside>
      <div class="workspace-body">
        <header class="workspace-topbar">
          <div class="workspace-breadcrumb"><span>Administration</span><span aria-hidden="true">/</span><strong>{area}</strong></div>
          <a class="workspace-live" href="/" target="_blank" rel="noopener noreferrer">View website <span aria-hidden="true">↗</span></a>
        </header>
        <main class="admin-main" id="admin-main-content" tabindex="-1"><slot /></main>
        <footer class="admin-footer"><span>Aniq Saidi · Administration</span><span>v{__SITE_VERSION__}</span></footer>
      </div>
    </div>
    <script>
      const updateNavigation = () => {
        const currentPath = location.pathname.replace(/\/$/, '');
        document.querySelectorAll<HTMLAnchorElement>('[data-workspace-link]').forEach((link) => {
          const target = new URL(link.href);
          const active = target.pathname.replace(/\/$/, '') === currentPath && target.hash === location.hash;
          if (active) link.setAttribute('aria-current', target.hash ? 'location' : 'page');
          else link.removeAttribute('aria-current');
        });
      };
      updateNavigation();
      window.addEventListener('hashchange', updateNavigation);
    </script>
  </body>
</html>
