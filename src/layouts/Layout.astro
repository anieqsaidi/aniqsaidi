---
import '../styles/terminal.css';
import TerminalHeader from '../components/TerminalHeader.astro';
import TerminalFooter from '../components/TerminalFooter.astro';
import HackGate from '../components/HackGate.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  PRIVATE_MODE,
  SITE_VENDOR,
  SITE_SYSTEM,
  SITE_MODEL,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} // ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL('/social/aniq-terminal-social.png', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="blue">
  <head>
    <meta charset="UTF-8" />
    <GoogleAnalytics />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta name="description" id="site-meta-description" content={description} />
    <link rel="canonical" id="site-canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" id="site-og-title" content={pageTitle} />
    <meta property="og:description" id="site-og-description" content={description} />
    <meta property="og:url" id="site-og-url" content={canonicalUrl} />
    <meta property="og:image" id="site-og-image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" id="site-twitter-title" content={pageTitle} />
    <meta name="twitter:description" id="site-twitter-description" content={description} />
    <meta name="twitter:image" id="site-twitter-image" content={socialImageUrl} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <title id="site-page-title">{pageTitle}</title>
    <!-- Apply the saved theme before first paint so it does not flash. -->
    <script is:inline>
      document.documentElement.dataset.js = 'true';
      const saved = localStorage.getItem('theme');
      if (saved === 'green' || saved === 'amber' || saved === 'blue' || saved === 'black') {
        document.documentElement.dataset.theme = saved;
      }

    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">SKIP TO CONTENT</a>
    <!-- Power-on screen: once per session, followed by a brisk automatic countdown. -->
    <div class="crt-boot" id="crt-boot" role="status" aria-label="System startup">
      <div class="crt-boot__screen">
        <pre class="crt-boot__lines" aria-hidden="true">{[
          `${SITE_VENDOR} (TM) ${SITE_SYSTEM} PROTOCOL`,
          `INITIALIZING ${SITE_MODEL}...`,
          '',
          '> SET TERMINAL/INQUIRE',
          SITE_MODEL,
          '> SET FILE/PROTECTION=OWNER:RWED ACCOUNTS.F',
          '> SET HALT RESTART/MAINT',
          '',
          `INITIALIZING ${SITE_VENDOR}(TM) BOOT AGENT v2.3.0`,
          'RETROS BIOS  RBIOS-4.02.08.00 52EE5.E7.E8',
          `COPYRIGHT 1984-1991 ${SITE_VENDOR}`,
          'UPPERMEM: 64 KB   ROOT: 05EAC8FF',
          'EXECUTING THREAD...',
          'LOAD ' + SITE_TITLE + ' // READY',
        ].map((line, i) => (
          <span class="boot-line" style={`--i:${i}`}>{line + '\n'}</span>
        ))}</pre>
        <div class="crt-boot__skip" aria-live="polite">
          <span>[ REDIRECTING IN <span class="crt-boot__count" id="crt-boot-count">3</span>... ]</span>
        </div>
      </div>
      <div class="crt-boot__matrix" aria-hidden="true">
        {['01A7//SYS','1100<>RUN','ANIQ0101','101//HOME','00110110','BOOT//01','11001010','SYS<>101','0101RUN','HOME//11','10110001','001<>SYS'].map((stream, index) => (
          <span style={`--column:${index};--delay:${(index % 4) * -0.045}s`}>{stream}<br />{stream}<br />{stream}</span>
        ))}
      </div>
    </div>
    <script is:inline>
      // Skip the screen entirely rather than flashing it and hiding it.
      (function () {
        var boot = document.getElementById('crt-boot');
        if (!boot) return;
        var mq = window.matchMedia;
        var reduce = mq && mq('(prefers-reduced-motion: reduce)').matches;
        if (reduce || sessionStorage.getItem('booted-v3')) {
          boot.classList.add('crt-boot--off');
        } else {
          document.body.classList.add('boot-active');
        }
      })();
    </script>

    {PRIVATE_MODE && <HackGate />}

    <div class="crt">
      <div class="container">
        <TerminalHeader />
        <main id="main-content" class="site-content-loading" tabindex="-1" aria-busy="true">
          <slot />
        </main>
        <TerminalFooter />
      </div>
    </div>

    <script>
      import { sfx, bindSfx } from '../scripts/sfx';
      import { loadSiteContent } from '../scripts/siteContent';

      loadSiteContent().finally(() => {
        const main = document.getElementById('main-content');
        main?.classList.remove('site-content-loading');
        main?.removeAttribute('aria-busy');
      });

      // Every interactive link and button uses the terminal sound system.
      bindSfx(document, 'a, button');

      // Keep the footer sound control in sync with the audio engine.
      const soundBtns = document.querySelectorAll<HTMLButtonElement>(
        '[data-action="sound"]',
      );

      function drawSound() {
        soundBtns.forEach((btn) => {
          btn.setAttribute('aria-pressed', String(sfx.enabled));
          const label = btn.querySelector<HTMLElement>('[data-sound-label]');
          if (label) label.textContent = sfx.enabled ? '♪ SOUND ON' : '♪ SOUND OFF';
        });
      }
      drawSound();

      soundBtns.forEach((btn) =>
        btn.addEventListener('click', () => {
          sfx.enabled = !sfx.enabled;
          drawSound();
          if (sfx.enabled) sfx.select(); // Confirm switching on, audibly.
        }),
      );

      (function () {
        const boot = document.getElementById('crt-boot');
        if (!boot || boot.classList.contains('crt-boot--off')) return;
        const countdown = document.getElementById('crt-boot-count');
        let count = 3;
        let finished = false;

        const finishBoot = () => {
          if (finished) return;
          finished = true;
          sessionStorage.setItem('booted-v3', '1');
          boot.classList.add('crt-boot--done');
          document.body.classList.remove('boot-active');
          setTimeout(() => boot.remove(), 560);
        };

        const tick = () => {
          if (!countdown) return finishBoot();
          countdown.textContent = String(count);
          countdown.classList.remove('is-ticking');
          void countdown.offsetWidth;
          countdown.classList.add('is-ticking');

          if (count === 1) {
            setTimeout(finishBoot, 650);
            return;
          }

          count -= 1;
          setTimeout(tick, 650);
        };

        // The diagnostic lines establish the scene, then a brisk 3–2–1 begins.
        setTimeout(tick, 1450);
      })();

      function toggleTheme() {
        const el = document.documentElement;
        const themes = ['amber', 'green', 'blue', 'black'];
        const currentTheme = el.dataset.theme ?? 'blue';
        const next = themes[(themes.indexOf(currentTheme) + 1) % themes.length];
        el.dataset.theme = next;
        localStorage.setItem('theme', next);
        drawTheme();
        sfx.power(); // The screen "relights", so the phosphor hums.
      }

      function drawTheme() {
        const theme = document.documentElement.dataset.theme ?? 'blue';
        const names: Record<string, string> = {
          amber: 'amber',
          green: 'green',
          blue: 'sky blue',
          black: 'black and white',
        };
        const nextNames: Record<string, string> = {
          amber: 'green',
          green: 'sky blue',
          blue: 'black and white',
          black: 'amber',
        };
        document.querySelectorAll<HTMLButtonElement>('[data-action="theme"]').forEach((btn) => {
          btn.setAttribute(
            'aria-label',
            `Theme: ${names[theme]}. Activate for ${nextNames[theme]}.`,
          );
          btn.title = `Current theme: ${names[theme]}`;
        });
      }
      drawTheme();

      document
        .querySelectorAll('[data-action="theme"]')
        .forEach((btn) => btn.addEventListener('click', toggleTheme));

      window.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement;
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        switch (e.key.toLowerCase()) {
          // Each hotkey is listed twice: the Latin key and the same
          // physical key under a Russian keyboard layout.
          case 'h':
          case 'р':
            location.href = '/';
            break;
          case 'a':
          case 'ф':
            location.href = '/about/';
            break;
          case 'e':
          case 'у':
            location.href = '/experience/';
            break;
          case 'p':
          case 'з':
            location.href = '/projects/';
            break;
          case 'c':
          case 'с':
            location.href = '/certifications/';
            break;
          case 'w':
          case 'ц':
            location.href = '/awards/';
            break;
          case 'l':
          case 'д':
            location.href = '/leadership/';
            break;
          case 'r':
          case 'к':
            location.href = '/archives/';
            break;
          case 't':
          case 'е':
            toggleTheme();
            break;
        }
      });
    </script>
  </body>
</html>
