---
import '../styles/terminal.css';
import TerminalHeader from '../components/TerminalHeader.astro';
import TerminalFooter from '../components/TerminalFooter.astro';
import HackGate from '../components/HackGate.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  PRIVATE_MODE,
  SITE_VENDOR,
  SITE_SYSTEM,
  SITE_MODEL,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} // ${SITE_TITLE}` : SITE_TITLE;
const mobileViewportPages = new Set([
  '/',
  '/about',
  '/about/',
  '/experience',
  '/experience/',
  '/certifications',
  '/certifications/',
  '/awards',
  '/awards/',
  '/leadership',
  '/leadership/',
]);
const isMobileViewportPage = mobileViewportPages.has(Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-theme="amber">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <title>{pageTitle}</title>
    <!-- Apply the saved theme before first paint so it does not flash. -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved === 'green' || saved === 'amber' || saved === 'blue' || saved === 'black') {
        document.documentElement.dataset.theme = saved;
      }

      // Detect compact screens before the body is painted. A temporary style
      // prevents expanded desktop content from flashing during navigation.
      if (window.matchMedia('(max-width: 640px)').matches) {
        document.documentElement.dataset.viewport = 'mobile';
        var mobilePreflightStyle = document.createElement('style');
        mobilePreflightStyle.id = 'mobile-preflight-style';
        mobilePreflightStyle.textContent =
          '.mobile-viewport-page .crt { visibility: hidden !important; }';
        document.head.appendChild(mobilePreflightStyle);
      } else {
        document.documentElement.dataset.viewport = 'desktop';
      }
    </script>
  </head>
  <body class:list={{ 'mobile-viewport-page': isMobileViewportPage }}>
    <!-- Power-on screen: once per session, dismissed by any click or key. -->
    <div class="crt-boot" id="crt-boot" aria-hidden="true">
      <div class="crt-boot__screen">
        <pre class="crt-boot__lines">{[
          `${SITE_VENDOR} (TM) ${SITE_SYSTEM} PROTOCOL`,
          `INITIALIZING ${SITE_MODEL}...`,
          '',
          '> SET TERMINAL/INQUIRE',
          SITE_MODEL,
          '> SET FILE/PROTECTION=OWNER:RWED ACCOUNTS.F',
          '> SET HALT RESTART/MAINT',
          '',
          `INITIALIZING ${SITE_VENDOR}(TM) BOOT AGENT v2.3.0`,
          'RETROS BIOS  RBIOS-4.02.08.00 52EE5.E7.E8',
          `COPYRIGHT 1984-1991 ${SITE_VENDOR}`,
          'UPPERMEM: 64 KB   ROOT: 05EAC8FF',
          'EXECUTING THREAD...',
          'LOAD ' + SITE_TITLE + ' // READY',
        ].map((line, i) => (
          <span class="boot-line" style={`--i:${i}`}>{line + '\n'}</span>
        ))}</pre>
        <div class="crt-boot__skip">[ PRESS ANY KEY ]</div>
      </div>
    </div>
    <script is:inline>
      // Skip the screen entirely rather than flashing it and hiding it.
      (function () {
        var boot = document.getElementById('crt-boot');
        if (!boot) return;
        var mq = window.matchMedia;
        var reduce = mq && mq('(prefers-reduced-motion: reduce)').matches;
        var narrow = mq && mq('(max-width: 640px)').matches;
        if (reduce || narrow || sessionStorage.getItem('booted')) {
          boot.classList.add('crt-boot--off');
        }
      })();
    </script>

    {PRIVATE_MODE && <HackGate />}

    <div class="crt">
      <div class="container">
        <TerminalHeader />
        <main>
          <slot />
        </main>
        <TerminalFooter />
      </div>
    </div>

    <script is:inline>
      // Resolve the initial compact layout synchronously, before first paint.
      (function () {
        var root = document.documentElement;
        if (root.dataset.viewport === 'mobile') {
          document.querySelectorAll('details.mobile-more[open]').forEach(function (details) {
            details.removeAttribute('open');
          });

          var pageMain = document.querySelector('main');
          if (pageMain) {
            document.querySelectorAll('[data-fit-group]').forEach(function (group) {
              var visible = group.querySelector('[data-fit-visible]');
              var overflow = group.querySelector('[data-fit-overflow]');
              var details = group.querySelector('[data-fit-details]');
              if (!visible || !overflow || !details) return;

              var items = Array.from(group.querySelectorAll('[data-fit-item]')).sort(
                function (a, b) {
                  return Number(a.getAttribute('data-order')) - Number(b.getAttribute('data-order'));
                },
              );
              var minimum = Number(group.getAttribute('data-mobile-min') || 1);
              // The disclosure must participate in measurement so it cannot
              // be pushed below the clipped mobile viewport.
              details.hidden = false;
              items.forEach(function (item) { visible.appendChild(item); });

              while (pageMain.scrollHeight > pageMain.clientHeight && visible.children.length > minimum) {
                var last = visible.lastElementChild;
                if (!last) break;
                overflow.prepend(last);
              }
              details.hidden = overflow.children.length === 0;
            });
          }
        }

        root.dataset.fitReady = 'true';
        document.getElementById('mobile-preflight-style')?.remove();
      })();
    </script>

    <script>
      import { sfx, bindSfx } from '../scripts/sfx';

      // Every interactive link and button uses the terminal sound system.
      bindSfx(document, 'a, button, summary');

      // Read-more disclosures unlock document scrolling on compact mobile
      // views. The class fallback also supports browsers without CSS :has().
      const disclosures = document.querySelectorAll<HTMLDetailsElement>('details');
      const mobileDisclosureMedia = window.matchMedia('(max-width: 640px)');
      const mobileOnlyDisclosures = document.querySelectorAll<HTMLDetailsElement>(
        'details.mobile-more',
      );

      function syncMobileOnlyDisclosures() {
        document.documentElement.dataset.viewport = mobileDisclosureMedia.matches
          ? 'mobile'
          : 'desktop';
        mobileOnlyDisclosures.forEach((details) => {
          details.open = !mobileDisclosureMedia.matches;
        });
      }

      function syncDisclosures() {
        document.body.classList.toggle(
          'has-open-details',
          Boolean(document.querySelector('details[open]')),
        );
        disclosures.forEach((details) => {
          details
            .closest('.frame-body')
            ?.classList.toggle('has-open-details', details.open);
        });
      }
      disclosures.forEach((details) => details.addEventListener('toggle', syncDisclosures));
      mobileDisclosureMedia.addEventListener('change', syncMobileOnlyDisclosures);
      syncMobileOnlyDisclosures();
      syncDisclosures();

      // Repeated credentials use the real rendered viewport height instead of
      // one hard-coded mobile count. Show as many as fit, then move the rest
      // into the existing disclosure without changing their order.
      const fitGroups = document.querySelectorAll<HTMLElement>('[data-fit-group]');

      function fitViewportLists() {
        const mobile = mobileDisclosureMedia.matches;
        const pageMain = document.querySelector<HTMLElement>('main');
        if (!pageMain) return;

        fitGroups.forEach((group) => {
          const visible = group.querySelector<HTMLElement>('[data-fit-visible]');
          const overflow = group.querySelector<HTMLElement>('[data-fit-overflow]');
          const details = group.querySelector<HTMLDetailsElement>('[data-fit-details]');
          if (!visible || !overflow || !details || (mobile && details.open)) return;

          const items = [...group.querySelectorAll<HTMLElement>('[data-fit-item]')].sort(
            (a, b) => Number(a.dataset.order) - Number(b.dataset.order),
          );
          const desktopCount = Number(group.dataset.desktopCount ?? items.length);
          const minimum = Number(group.dataset.mobileMin ?? 1);

          // Always reserve the disclosure's rendered height while fitting.
          // Otherwise a previously hidden summary can make too many rows look
          // like they fit, then appear below the clipped viewport.
          details.hidden = false;
          items.forEach((item) => visible.append(item));

          if (mobile) {
            while (
              pageMain.scrollHeight > pageMain.clientHeight &&
              visible.children.length > minimum
            ) {
              const last = visible.lastElementChild;
              if (!last) break;
              overflow.prepend(last);
            }
          } else {
            items.slice(desktopCount).forEach((item) => overflow.append(item));
          }

          details.hidden = overflow.children.length === 0;
        });
      }

      let fitTimer = 0;
      function queueViewportFit() {
        window.clearTimeout(fitTimer);
        fitTimer = window.setTimeout(fitViewportLists, 60);
      }

      document.fonts?.ready.then(fitViewportLists);
      window.addEventListener('resize', queueViewportFit);

      // Two sound buttons exist (header and footer) and only one is ever
      // visible, but both have to stay in sync.
      const soundBtns = document.querySelectorAll<HTMLButtonElement>(
        '[data-action="sound"]',
      );

      function drawSound() {
        soundBtns.forEach((btn) => {
          btn.setAttribute('aria-pressed', String(sfx.enabled));
          const label = btn.querySelector<HTMLElement>('[data-sound-label]');
          if (label) label.textContent = sfx.enabled ? '♪ SOUND ON' : '♪ SOUND OFF';
        });
      }
      drawSound();

      soundBtns.forEach((btn) =>
        btn.addEventListener('click', () => {
          sfx.enabled = !sfx.enabled;
          drawSound();
          if (sfx.enabled) sfx.select(); // Confirm switching on, audibly.
        }),
      );

      (function () {
        const boot = document.getElementById('crt-boot');
        if (!boot || boot.classList.contains('crt-boot--off')) return;
        sessionStorage.setItem('booted', '1');
        let done = false;
        const dismiss = () => {
          if (done) return;
          done = true;
          boot.classList.add('crt-boot--done');
          setTimeout(() => boot.remove(), 400);
        };
        boot.addEventListener('click', dismiss);
        // Catch the key before the nav hotkeys so it only dismisses boot.
        window.addEventListener(
          'keydown',
          (e) => {
            e.stopImmediatePropagation();
            dismiss();
          },
          { once: true, capture: false },
        );
        setTimeout(dismiss, 2600);
      })();

      function toggleTheme() {
        const el = document.documentElement;
        const themes = ['amber', 'green', 'blue', 'black'];
        const currentTheme = el.dataset.theme ?? 'amber';
        const next = themes[(themes.indexOf(currentTheme) + 1) % themes.length];
        el.dataset.theme = next;
        localStorage.setItem('theme', next);
        drawTheme();
        sfx.power(); // The screen "relights", so the phosphor hums.
      }

      function drawTheme() {
        const theme = document.documentElement.dataset.theme ?? 'amber';
        const names: Record<string, string> = {
          amber: 'amber',
          green: 'green',
          blue: 'sky blue',
          black: 'black and white',
        };
        const nextNames: Record<string, string> = {
          amber: 'green',
          green: 'sky blue',
          blue: 'black and white',
          black: 'amber',
        };
        document.querySelectorAll<HTMLButtonElement>('[data-action="theme"]').forEach((btn) => {
          btn.setAttribute(
            'aria-label',
            `Theme: ${names[theme]}. Activate for ${nextNames[theme]}.`,
          );
          btn.title = `Current theme: ${names[theme]}`;
        });
      }
      drawTheme();

      document
        .querySelectorAll('[data-action="theme"]')
        .forEach((btn) => btn.addEventListener('click', toggleTheme));

      window.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement;
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        switch (e.key.toLowerCase()) {
          // Each hotkey is listed twice: the Latin key and the same
          // physical key under a Russian keyboard layout.
          case 'h':
          case 'р':
            location.href = '/';
            break;
          case 'a':
          case 'ф':
            location.href = '/about/';
            break;
          case 'e':
          case 'у':
            location.href = '/experience/';
            break;
          case 'c':
          case 'с':
            location.href = '/certifications/';
            break;
          case 'w':
          case 'ц':
            location.href = '/awards/';
            break;
          case 'l':
          case 'д':
            location.href = '/leadership/';
            break;
          case 't':
          case 'е':
            toggleTheme();
            break;
        }
      });
    </script>
  </body>
</html>
