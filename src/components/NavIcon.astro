---
interface Props {
  name: 'home' | 'about' | 'projects' | 'experience' | 'certifications' | 'awards' | 'leadership' | 'archives';
}

const { name } = Astro.props;
---

<svg class="nav-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'home' && <><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10.5V20h13v-9.5M9.5 20v-6h5v6"/></>}
  {name === 'about' && <><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.7-4 3-6 7-6s6.3 2 7 6"/></>}
  {name === 'projects' && <><path d="m9 7-5 5 5 5M15 7l5 5-5 5M13.5 4l-3 16"/></>}
  {name === 'experience' && <><rect x="3" y="7" width="18" height="12" rx="1"/><path d="M9 7V4h6v3M3 12h18M10 12v2h4v-2"/></>}
  {name === 'certifications' && <><circle cx="12" cy="9" r="6"/><path d="m9.5 15-1 6 3.5-2 3.5 2-1-6M9.5 9l1.5 1.5L14.5 7"/></>}
  {name === 'awards' && <><path d="M8 4h8v4c0 3-1.5 5-4 5S8 11 8 8V4Z"/><path d="M8 6H4c0 3 1.5 5 4.5 5M16 6h4c0 3-1.5 5-4.5 5M12 13v4M8 20h8M9 17h6"/></>}
  {name === 'leadership' && <><circle cx="12" cy="7" r="3"/><circle cx="5.5" cy="10" r="2.5"/><circle cx="18.5" cy="10" r="2.5"/><path d="M7 20c.4-4 2-6 5-6s4.6 2 5 6M1.5 20c.2-3 1.5-4.5 4-4.5 1.2 0 2.2.4 3 1.1M22.5 20c-.2-3-1.5-4.5-4-4.5-1.2 0-2.2.4-3 1.1"/></>}
  {name === 'archives' && <><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5M3 7v13h13"/></>}
</svg>

<style>
  .nav-icon-svg {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
</style>
