---
import { SITE_TITLE, SITE_VERSION, SITE_BUILD_ID } from '../consts';
import AnimatedWord from './AnimatedWord.astro';

const buildDate = new Date()
  .toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  .toUpperCase();

const { pathname } = Astro.url;
const current = (path: string) =>
  pathname === path || pathname === path.replace(/\/$/, '') ? 'page' : undefined;
const currentSection = (path: string) => pathname.startsWith(path) ? 'page' : undefined;
---

<header class="t-header">
  <a class="logo" href="/" aria-label="Home">
    <span class="logo-glyph" aria-hidden="true">&gt;_</span>
    <span class="logo-name">{SITE_TITLE}</span>
  </a>
  <div class="h-info">
    <div class="h-line h-line-top">
      <span class="header-command" aria-label="aniq at system, home, who am I">
        <span class="header-command-user">aniq@system</span>
        <span class="header-command-path">~/home</span>
        <span aria-hidden="true">%</span>
        <AnimatedWord text="whoami" effect="decode" delay={-2.4} alt="wh0am1" />
        <span class="tagline-cursor" aria-hidden="true">_</span>
      </span>
      <time class="header-clock" id="header-clock" aria-label="Current time in Malaysia">
        <span id="clock-hour">--</span><span class="clock-separator" aria-hidden="true">:</span><span id="clock-minute">--</span> MYT
      </time>
    </div>
    <div class="h-line h-line-bottom">
      <span>BUILD: {SITE_BUILD_ID} VER {SITE_VERSION}</span>
      <span>
        <span id="birthday-emoji" role="img" aria-label="Birthday" hidden>🎉 </span>
        {buildDate}
      </span>
    </div>
    <nav class="h-nav" aria-label="Primary navigation">
      <a href="/" aria-current={current('/')}>&gt; HOME</a>
      <a href="/about/" aria-current={current('/about/')}>&gt; ABOUT</a>
      <a href="/projects/" aria-current={currentSection('/projects')}>
        &gt;&nbsp;<span class="nav-label-full">PROJECTS</span><span class="nav-label-short">WORK</span>
      </a>
      <a href="/experience/" aria-current={current('/experience/')}>
        &gt;&nbsp;<span class="nav-label-full">EXPERIENCE</span><span class="nav-label-short">EXP</span>
      </a>
      <a href="/certifications/" aria-current={current('/certifications/')}>
        &gt;&nbsp;<span class="nav-label-full">CERTIFICATIONS</span><span class="nav-label-short">CERTS</span>
      </a>
      <a href="/awards/" aria-current={current('/awards/')}>&gt; AWARDS</a>
      <a href="/leadership/" aria-current={current('/leadership/')}>
        &gt;&nbsp;<span class="nav-label-full">LEADERSHIP</span><span class="nav-label-short">LEAD</span>
      </a>
      <a href="/archives/" aria-current={currentSection('/archives')}>
        &gt;&nbsp;<span class="nav-label-full">ARCHIVES</span><span class="nav-label-short">PRESS</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var today = new Date();
    var birthdayEmoji = document.getElementById('birthday-emoji');
    var clock = document.getElementById('header-clock');
    var clockHour = document.getElementById('clock-hour');
    var clockMinute = document.getElementById('clock-minute');

    function updateClock() {
      if (!clock || !clockHour || !clockMinute) return;

      var now = new Date();
      var malaysiaTime = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Kuala_Lumpur',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).format(now);

      var timeParts = malaysiaTime.split(':');
      clockHour.textContent = timeParts[0];
      clockMinute.textContent = timeParts[1];
      clock.setAttribute('datetime', now.toISOString());
      clock.setAttribute('aria-label', malaysiaTime + ' Malaysia Time');

      // Update just after the minute changes instead of polling every second.
      window.setTimeout(updateClock, 60050 - (Date.now() % 60000));
    }

    updateClock();

    if (birthdayEmoji && today.getMonth() === 7 && today.getDate() === 2) {
      birthdayEmoji.hidden = false;
    }
  })();
</script>
