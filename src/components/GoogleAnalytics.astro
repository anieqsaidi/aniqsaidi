---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? '';
const isValidMeasurementId = /^G-[A-Z0-9]+$/i.test(measurementId);
const isPublicPage = !Astro.url.pathname.startsWith('/admin');
const analyticsEnabled = import.meta.env.PROD && isPublicPage && isValidMeasurementId;
---

{analyticsEnabled && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`}></script>
    <script is:inline define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', measurementId);
    </script>
  </>
)}
