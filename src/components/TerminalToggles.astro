---
// Theme and sound controls live at the bottom of the shared terminal footer.
// The script in Layout.astro drives their state and interactions.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<div class:list={['toggles', cls]}>
  <!-- data-sfx="hover": the buttons make their own sound on click. -->
  <button class="nav-theme" data-action="theme" data-sfx="hover" type="button">
    ⦿ THEME: <span data-theme-label>DARK</span>
  </button>
  <button
    class="nav-sound"
    data-action="sound"
    data-sfx="hover"
    type="button"
    aria-pressed="true"
  >
    <span data-sound-label>♪ SOUND ON</span>
  </button>
</div>
